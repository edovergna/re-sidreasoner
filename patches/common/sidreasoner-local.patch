diff --git a/scripts/evaluate_models_in_dir.sh b/scripts/evaluate_models_in_dir.sh
new file mode 100644
index 0000000..ae3043f
--- /dev/null
+++ b/scripts/evaluate_models_in_dir.sh
@@ -0,0 +1,152 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=sid-eval-dir
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=16:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+# No email notifications are enabled by default.
+# Email notifications may be configured with sbatch --mail-user.
+
+# Evaluate EVERY model (any dir containing config.json) under the given root dir(s).
+# Category (Video_Games / Office_Products / Industrial) is inferred per-model from
+# the path, so a mixed model-size folder works in one shot. Thinking-mode eval,
+# constrained beam-10. Idempotent: skips generation for models already evaluated,
+# but still includes them in the final summary table. Prints one HR/NDCG table at
+# the end built ONLY from the models processed in this run.
+#
+# Usage:
+#   sbatch scripts/evaluate_models_in_dir.sh ./checkpoints/1.7B
+#   sbatch scripts/evaluate_models_in_dir.sh .../checkpoints/0.6B .../checkpoints/1.7B
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./scripts/cluster_env.sh
+
+ROOTS=("$@")
+if [[ ${#ROOTS[@]} -eq 0 ]]; then
+    echo "usage: $0 <dir> [dir ...]   (each dir is scanned for models = dirs with config.json)"
+    exit 1
+fi
+
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+SFX="${SUFFIX:-_5_2016-10-2018-11}"
+
+infer_category() {
+    case "$1" in
+        *Video_Games*)     echo "Video_Games" ;;
+        *Office_Products*) echo "Office_Products" ;;
+        *Industrial*)      echo "Industrial" ;;
+        *)                 echo "" ;;
+    esac
+}
+
+# Collect model dirs (those containing a config.json) under all roots.
+model_dirs=()
+for root in "${ROOTS[@]}"; do
+    if [[ ! -d "$root" ]]; then
+        echo "Warning: not a directory, skipping: $root"
+        continue
+    fi
+    while IFS= read -r cfg_dir; do
+        [[ -n "$cfg_dir" ]] && model_dirs+=("$cfg_dir")
+    done < <(find "$root" -name config.json -printf '%h\n' | sort -u)
+done
+
+if [[ ${#model_dirs[@]} -eq 0 ]]; then
+    echo "No models (dirs with config.json) found under: ${ROOTS[*]}"
+    exit 1
+fi
+
+echo "Found ${#model_dirs[@]} model(s):"
+printf '  %s\n' "${model_dirs[@]}"
+
+SUMMARY_ROWS=()   # one formatted row per model processed this run
+
+for model in "${model_dirs[@]}"; do
+    CATEGORY=$(infer_category "$model")
+    if [[ -z "$CATEGORY" ]]; then
+        echo "SKIP (cannot infer category from path): $model"
+        continue
+    fi
+
+    TEST_FILE="./data/Amazon/test/${CATEGORY}${SFX}.csv"
+    INFO_FILE="./data/Amazon/info/${CATEGORY}${SFX}.txt"
+    ITEM_FILE="./data/Amazon/index/${CATEGORY}.item.json"
+    INDEX_FILE="./data/Amazon/index/${CATEGORY}.index.json"
+    if [[ ! -f "$TEST_FILE" || ! -f "$INFO_FILE" ]]; then
+        echo "SKIP (missing data files for ${CATEGORY}): $model"
+        continue
+    fi
+
+    name_clean=$(echo "$model" | sed 's#^.*/checkpoints/##; s#^.*/output_dir/##; s#/#__#g')
+    out_dir="./results/${name_clean}"
+    final_json="${out_dir}/final_result_thinking_${CATEGORY}.json"
+
+    if [[ -f "$final_json" ]]; then
+        echo "=== ${name_clean}: already evaluated, scoring from cache ==="
+    else
+        echo "=== Evaluating ${name_clean}  (category=${CATEGORY}) ==="
+        temp_dir="./temp/${name_clean}"
+        mkdir -p "$temp_dir" "$out_dir"
+
+        ${PYTHON_CMD} ./split.py --input_path "$TEST_FILE" --output_path "$temp_dir" --cuda_list "$CUDA_LIST_CSV"
+
+        for i in ${CUDA_LIST}; do
+            if [[ -f "${temp_dir}/${i}.csv" ]]; then
+                CUDA_VISIBLE_DEVICES=${i} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                    --base_model "$model" \
+                    --info_file "$INFO_FILE" \
+                    --category "$CATEGORY" \
+                    --test_data_path "${temp_dir}/${i}.csv" \
+                    --item_file "$ITEM_FILE" \
+                    --index_file "$INDEX_FILE" \
+                    --result_json_data "${temp_dir}/${i}.json" \
+                    --batch_size 4 \
+                    --num_beams 10 \
+                    --max_new_tokens 1024 \
+                    --length_penalty 0.0 &
+            fi
+        done
+        wait
+
+        if [[ $(find "$temp_dir" -maxdepth 1 -name '*.json' | wc -l) -eq 0 ]]; then
+            echo "Error: no result shards for ${name_clean}"
+            continue
+        fi
+        actual=""
+        for g in ${CUDA_LIST}; do
+            [[ -f "${temp_dir}/${g}.json" ]] && actual="${actual}${g},"
+        done
+        actual="${actual%,}"
+        ${PYTHON_CMD} ./merge.py --input_path "$temp_dir" --output_path "$final_json" --cuda_list "$actual"
+    fi
+
+    [[ -f "$final_json" ]] || { echo "Error: no result for ${name_clean}"; continue; }
+
+    # Score with calc.py and capture its HR/NDCG arrays for the summary table.
+    calc_out=$(${PYTHON_CMD} ./calc.py --path "$final_json" --item_path "$INFO_FILE")
+    echo "$calc_out"
+    # calc.py prints: "NDCG:\t[v@1 v@3 v@5 v@10]" and "HR\t[v@1 v@3 v@5 v@10]" (beam=10).
+    hr_vals=$(echo "$calc_out"   | grep -E '^HR'   | tail -1 | sed -E 's/^HR[[:space:]]*\[//; s/\].*$//')
+    ndcg_vals=$(echo "$calc_out" | grep -E '^NDCG' | tail -1 | sed -E 's/^NDCG:?[[:space:]]*\[//; s/\].*$//')
+    read -r _h1 _h3 h5 h10 _rest <<< "$hr_vals"
+    read -r _d1 _d3 d5 d10 _drest <<< "$ndcg_vals"
+    SUMMARY_ROWS+=("$(printf '%-52s %-14s %8s %8s %8s %8s' "${name_clean:0:52}" "$CATEGORY" "${h5:-NA}" "${h10:-NA}" "${d5:-NA}" "${d10:-NA}")")
+    echo "----------------------------------------"
+done
+
+echo ""
+echo "===================== SUMMARY (this run) ====================="
+printf '%-52s %-14s %8s %8s %8s %8s\n' "model" "category" "HR@5" "HR@10" "N@5" "N@10"
+printf '%s\n' "${SUMMARY_ROWS[@]}"
+echo "Results under ./results/"
