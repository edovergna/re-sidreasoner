diff --git a/final_scripts/rq5_diversity/evaluate_item_side_diversity.sh b/final_scripts/rq5_diversity/evaluate_item_side_diversity.sh
new file mode 100644
index 0000000..9ca7569
--- /dev/null
+++ b/final_scripts/rq5_diversity/evaluate_item_side_diversity.sh
@@ -0,0 +1,242 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=item-side-div
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=48:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+if [[ -x "${PWD}/.venv/bin/python" ]]; then
+    PYTHON_CMD="${PWD}/.venv/bin/python"
+    export PYTHON_CMD
+fi
+
+CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-./pretrained}"
+RESULT_ROOT="${RESULT_ROOT:-./results/item_side_diversity}"
+TMP_ROOT="${TMP_ROOT:-${TMPDIR:-/tmp}/${USER:-user}/SIDReasoner_tmp/item_side_diversity/${SLURM_JOB_ID:-manual}}"
+MANIFEST_PATH="${MANIFEST_PATH:-${RESULT_ROOT}/manifest_${SLURM_JOB_ID:-manual}.tsv}"
+SUMMARY_PATH="${SUMMARY_PATH:-${RESULT_ROOT}/summary_${SLURM_JOB_ID:-manual}.md}"
+LOG_FILE="${LOG_FILE:-./logs/evaluate_item_side_diversity_${SLURM_JOB_ID:-manual}.log}"
+
+DATASETS="${DATASETS:-Video_Games Office_Products}"
+# The comparison table requires prediction JSONs for all three stages.
+# Existing predictions can be reused; metrics are recomputed by the table builder.
+STAGES="${STAGES:-sft ra rl}"
+DECODERS="${DECODERS:-beam10 sample_t12_p095 sample_t10_k50}"
+SEEDS="${SEEDS:-42 43 44}"
+
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+NUM_SAMPLES="${NUM_SAMPLES:--1}"
+BATCH_SIZE="${BATCH_SIZE:-4}"
+NUM_RETURN_SEQUENCES="${NUM_RETURN_SEQUENCES:-10}"
+MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
+REASONING_TEMPERATURE="${REASONING_TEMPERATURE:-0.0}"
+SKIP_EXISTING="${SKIP_EXISTING:-1}"
+
+mkdir -p ./logs ./slurm_output "${RESULT_ROOT}" "${TMP_ROOT}"
+printf "" > "${MANIFEST_PATH}"
+
+requested_gpu_count=$(wc -w <<< "${CUDA_LIST}")
+if [[ "${SLURM_GPUS_ON_NODE:-}" =~ ^[0-9]+$ ]] && (( SLURM_GPUS_ON_NODE < requested_gpu_count )); then
+    echo "Error: CUDA_LIST requests ${requested_gpu_count} GPUs (${CUDA_LIST}), but Slurm allocated ${SLURM_GPUS_ON_NODE}."
+    exit 1
+fi
+
+dataset_files() {
+    local dataset="$1"
+    TEST_FILE="./data/Amazon/test/${dataset}_5_2016-10-2018-11.csv"
+    INFO_FILE="./data/Amazon/info/${dataset}_5_2016-10-2018-11.txt"
+    ITEM_FILE="./data/Amazon/index/${dataset}.item.json"
+    INDEX_FILE="./data/Amazon/index/${dataset}.index.json"
+}
+
+checkpoint_path() {
+    local dataset="$1"
+    local stage="$2"
+    case "${dataset}:${stage}" in
+        Video_Games:sft) echo "${VIDEO_GAMES_SFT_CHECKPOINT:-${CHECKPOINT_ROOT}/Video_Games/sidreasoner_sft_games}" ;;
+        Video_Games:ra) echo "${VIDEO_GAMES_RA_CHECKPOINT:-${CHECKPOINT_ROOT}/Video_Games/sidreasoner_ra_games}" ;;
+        Video_Games:rl) echo "${VIDEO_GAMES_RL_CHECKPOINT:-${CHECKPOINT_ROOT}/Video_Games/Qwen3-1.7B_base_e2e-RA-GeneralReason_stepRule-smalllR_Games/actor_merged}" ;;
+        Office_Products:sft) echo "${OFFICE_PRODUCTS_SFT_CHECKPOINT:-${CHECKPOINT_ROOT}/Office_Products/sidreaonser_sft_office}" ;;
+        Office_Products:ra) echo "${OFFICE_PRODUCTS_RA_CHECKPOINT:-${CHECKPOINT_ROOT}/Office_Products/sidreasoner_ra_office}" ;;
+        Office_Products:rl) echo "${OFFICE_PRODUCTS_RL_CHECKPOINT:-${CHECKPOINT_ROOT}/Office_Products/Qwen3-1.7B_base_e2e-General_stepRule-smalllR_Office_Products/actor_merged}" ;;
+        *) echo "UNKNOWN" ;;
+    esac
+}
+
+decoder_config() {
+    local decoder="$1"
+    case "${decoder}" in
+        beam10)
+            DECODING_METHOD="beam"
+            NUM_BEAMS="10"
+            TEMPERATURE="0.0"
+            TOP_P="1.0"
+            TOP_K="0"
+            ;;
+        sample_t12_p095)
+            DECODING_METHOD="sample"
+            NUM_BEAMS="1"
+            TEMPERATURE="1.2"
+            TOP_P="0.95"
+            TOP_K="0"
+            ;;
+        sample_t10_k50)
+            DECODING_METHOD="sample"
+            NUM_BEAMS="1"
+            TEMPERATURE="1.0"
+            TOP_P="1.0"
+            TOP_K="50"
+            ;;
+        *)
+            echo "Unknown decoder: ${decoder}" >&2
+            exit 1
+            ;;
+    esac
+}
+
+{
+echo "Item-side diversity evaluation"
+echo "Datasets: ${DATASETS}"
+echo "Stages: ${STAGES}"
+echo "Decoders: ${DECODERS}"
+echo "Seeds: ${SEEDS}"
+echo "Result root: ${RESULT_ROOT}"
+echo "Temp root: ${TMP_ROOT}"
+echo "Manifest: ${MANIFEST_PATH}"
+echo "Summary: ${SUMMARY_PATH}"
+echo "Python: ${PYTHON_CMD}"
+echo "============================================================"
+
+for dataset in ${DATASETS}; do
+    dataset_files "${dataset}"
+    for required_file in "${TEST_FILE}" "${INFO_FILE}" "${ITEM_FILE}" "${INDEX_FILE}"; do
+        if [[ ! -f "${required_file}" ]]; then
+            echo "Error: required file not found: ${required_file}"
+            exit 1
+        fi
+    done
+
+    for stage in ${STAGES}; do
+        checkpoint="$(checkpoint_path "${dataset}" "${stage}")"
+        if [[ ! -d "${checkpoint}" || ! -f "${checkpoint}/config.json" ]]; then
+            echo "Error: checkpoint does not look usable for ${dataset}/${stage}: ${checkpoint}"
+            exit 1
+        fi
+
+        for decoder in ${DECODERS}; do
+            decoder_config "${decoder}"
+            for seed in ${SEEDS}; do
+                run_name="${dataset}_${stage}_${decoder}_seed${seed}"
+                temp_dir="${TMP_ROOT}/${run_name}"
+                output_dir="${RESULT_ROOT}/${dataset}/${stage}/${decoder}_seed${seed}"
+                output_json="${output_dir}/final_result_thinking_${dataset}.json"
+
+                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
+                    "${dataset}" "${stage}" "${decoder}" "${seed}" "${output_json}" "${INFO_FILE}" "${checkpoint}" >> "${MANIFEST_PATH}"
+
+                if [[ "${SKIP_EXISTING}" == "1" && -f "${output_json}" ]]; then
+                    echo "Skipping existing result: ${output_json}"
+                    continue
+                fi
+
+                echo
+                echo "============================================================"
+                echo "Running ${run_name}"
+                echo "Checkpoint: ${checkpoint}"
+                echo "decoding=${DECODING_METHOD} num_beams=${NUM_BEAMS} return=${NUM_RETURN_SEQUENCES} temp=${TEMPERATURE} top_p=${TOP_P} top_k=${TOP_K}"
+                echo "Output: ${output_json}"
+                echo "============================================================"
+
+                mkdir -p "${temp_dir}" "${output_dir}"
+
+                ${PYTHON_CMD} ./split.py \
+                    --input_path "${TEST_FILE}" \
+                    --output_path "${temp_dir}" \
+                    --cuda_list "${CUDA_LIST_CSV}" \
+                    --num_samples "${NUM_SAMPLES}"
+
+                pids=()
+                for gpu in ${CUDA_LIST}; do
+                    if [[ ! -f "${temp_dir}/${gpu}.csv" ]]; then
+                        echo "Warning: split file missing for GPU ${gpu}: ${temp_dir}/${gpu}.csv"
+                        continue
+                    fi
+                    master_port=$((24000 + (${SLURM_JOB_ID:-0} % 10000) + gpu))
+                    MASTER_ADDR=127.0.0.1 MASTER_PORT=${master_port} CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                        --base_model "${checkpoint}" \
+                        --info_file "${INFO_FILE}" \
+                        --category "${dataset}" \
+                        --test_data_path "${temp_dir}/${gpu}.csv" \
+                        --item_file "${ITEM_FILE}" \
+                        --index_file "${INDEX_FILE}" \
+                        --result_json_data "${temp_dir}/${gpu}.json" \
+                        --batch_size "${BATCH_SIZE}" \
+                        --num_beams "${NUM_BEAMS}" \
+                        --num_return_sequences "${NUM_RETURN_SEQUENCES}" \
+                        --max_new_tokens "${MAX_NEW_TOKENS}" \
+                        --length_penalty 0.0 \
+                        --decoding_method "${DECODING_METHOD}" \
+                        --temperature "${TEMPERATURE}" \
+                        --reasoning_temperature "${REASONING_TEMPERATURE}" \
+                        --top_p "${TOP_P}" \
+                        --top_k "${TOP_K}" \
+                        --seed "${seed}" &
+                    pids+=("$!")
+                done
+
+                failed=0
+                for pid in "${pids[@]}"; do
+                    if ! wait "${pid}"; then
+                        failed=1
+                    fi
+                done
+                if (( failed )); then
+                    echo "Error: at least one shard failed for ${run_name}."
+                    exit 1
+                fi
+
+                actual_cuda_list=""
+                for gpu in ${CUDA_LIST}; do
+                    if [[ -f "${temp_dir}/${gpu}.json" ]]; then
+                        actual_cuda_list="${actual_cuda_list}${gpu},"
+                    fi
+                done
+                actual_cuda_list="${actual_cuda_list%,}"
+                if [[ -z "${actual_cuda_list}" ]]; then
+                    echo "Error: no shard result files produced for ${run_name}."
+                    exit 1
+                fi
+
+                ${PYTHON_CMD} ./merge.py \
+                    --input_path "${temp_dir}" \
+                    --output_path "${output_json}" \
+                    --cuda_list "${actual_cuda_list}"
+
+                ${PYTHON_CMD} ./calc.py \
+                    --path "${output_json}" \
+                    --item_path "${INFO_FILE}"
+            done
+        done
+    done
+done
+
+${PYTHON_CMD} ./utils/summarize_item_side_diversity.py \
+    --manifest-path "${MANIFEST_PATH}" \
+    --output-path "${SUMMARY_PATH}" \
+    --title "Item-side diversity: SFT, RA, and RL decoding comparison"
+
+echo "Summary saved to: ${SUMMARY_PATH}"
+} 2>&1 | tee "${LOG_FILE}"
