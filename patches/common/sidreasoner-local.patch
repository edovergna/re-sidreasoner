--- /dev/null
+++ b/final_scripts/rq1_reproduction/evaluate_Qwen3_think_S1_bestof1.sh
@@ -0,0 +1,131 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=sid-S1-eval-bestof1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=08:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+# Reproduce Table 2 "before RL" for S1 = Best-of-N reasoning eval at N=1:
+# a SINGLE *sampled* reasoning (temperature > 0), then the same constrained-beam
+# SID generation. Evaluates the Phase B (reasoning-activation) checkpoint.
+#
+# Temperature is a POSITIONAL arg (env vars don't propagate on the cluster):
+#   sbatch scripts/evaluate_Qwen3_think_S1_bestof1.sh 1.0
+#   sbatch scripts/evaluate_Qwen3_think_S1_bestof1.sh 0.6
+# Sweep to match the paper's S1 before-RL R@10 = 0.0388.
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+
+# Positional args (env vars don't propagate on the cluster):
+#   $1 = reasoning sampling temperature (>0). default 1.0
+#   $2 = checkpoint to evaluate. default = Phase B (S1 before-RL).
+#        For "after RL", pass the merged GRPO actor, e.g.:
+#          sbatch scripts/evaluate_Qwen3_think_S1_bestof1.sh 1.0 \
+#            ./checkpoints/RecRL_Reasoning/Office_Products_stage3_rl_Qwen3-1.7B_S1/global_step_100/actor_merged
+TEMPERATURE="${1:-1.0}"
+EXP_NAME="${2:-./output_dir/Office_Products_stage2_reasoning_activation_Qwen3-1.7B_S1/final_checkpoint}"
+
+CATEGORY="${CATEGORY:-Office_Products}"
+TEST_FILE="${TEST_FILE:-./data/Amazon/test/Office_Products_5_2016-10-2018-11.csv}"
+INFO_FILE="${INFO_FILE:-./data/Amazon/info/Office_Products_5_2016-10-2018-11.txt}"
+ITEM_FILE="${ITEM_FILE:-./data/Amazon/index/Office_Products.item.json}"
+INDEX_FILE="${INDEX_FILE:-./data/Amazon/index/Office_Products.index.json}"
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+
+if [[ ! -d "${EXP_NAME}" ]]; then
+    echo "Error: checkpoint not found at ${EXP_NAME}"
+    exit 1
+fi
+if [[ ! -f "${TEST_FILE}" || ! -f "${INFO_FILE}" ]]; then
+    echo "Error: test/info file missing for ${CATEGORY}"
+    exit 1
+fi
+
+# namespace temp/results by temperature so sweeps don't overwrite each other
+tsafe="${TEMPERATURE//./p}"
+dir0=$(basename "$(dirname "$(dirname "$EXP_NAME")")")
+dir1=$(basename "$(dirname "$EXP_NAME")")
+dir2=$(basename "$EXP_NAME")
+exp_name_clean="${dir0}__${dir1}__${dir2}__bestof1_T${tsafe}"
+
+echo "Processing ${CATEGORY} | model: ${exp_name_clean} | reasoning temperature=${TEMPERATURE} (Best-of-N, N=1)"
+
+temp_dir="./temp/${CATEGORY}-${exp_name_clean}"
+rm -rf "${temp_dir}"   # never reuse stale jsons
+mkdir -p "${temp_dir}"
+
+echo "Splitting test data..."
+${PYTHON_CMD} ./split.py --input_path "${TEST_FILE}" --output_path "${temp_dir}" --cuda_list "${CUDA_LIST_CSV}"
+
+echo "Starting parallel evaluation (Best-of-N=1, sampled reasoning)..."
+for i in ${CUDA_LIST}
+do
+    if [[ -f "${temp_dir}/${i}.csv" ]]; then
+        echo "Starting evaluation on GPU ${i}"
+        CUDA_VISIBLE_DEVICES=${i} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+            --base_model "${EXP_NAME}" \
+            --info_file "${INFO_FILE}" \
+            --category "${CATEGORY}" \
+            --test_data_path "${temp_dir}/${i}.csv" \
+            --item_file "${ITEM_FILE}" \
+            --index_file "${INDEX_FILE}" \
+            --result_json_data "${temp_dir}/${i}.json" \
+            --batch_size 4 \
+            --num_beams 10 \
+            --max_new_tokens 1024 \
+            --length_penalty 0.0 \
+            --temperature "${TEMPERATURE}" &
+    else
+        echo "Warning: Split file ${temp_dir}/${i}.csv not found, skipping GPU ${i}"
+    fi
+done
+echo "Waiting for all evaluation processes to complete..."
+wait
+
+result_files=$(find "${temp_dir}" -maxdepth 1 -name '*.json' | wc -l)
+if [[ ${result_files} -eq 0 ]]; then
+    echo "Error: No result files generated (eval likely crashed). Check the traceback above."
+    exit 1
+fi
+
+output_dir="./results/${exp_name_clean}"
+mkdir -p "${output_dir}"
+
+actual_cuda_list=""
+for gpu in ${CUDA_LIST}; do
+    if [[ -f "${temp_dir}/${gpu}.json" ]]; then
+        actual_cuda_list="${actual_cuda_list}${gpu},"
+    fi
+done
+actual_cuda_list="${actual_cuda_list%,}"
+
+echo "Merging results from GPUs: ${actual_cuda_list}"
+${PYTHON_CMD} ./merge.py \
+    --input_path "${temp_dir}" \
+    --output_path "${output_dir}/final_result_thinking_${CATEGORY}.json" \
+    --cuda_list "${actual_cuda_list}"
+
+if [[ ! -f "${output_dir}/final_result_thinking_${CATEGORY}.json" ]]; then
+    echo "Error: Result merging failed for category ${CATEGORY}"
+    exit 1
+fi
+
+echo "Calculating metrics (compare R@10 against the paper's S1 before-RL = 0.0388)..."
+${PYTHON_CMD} ./calc.py \
+    --path "${output_dir}/final_result_thinking_${CATEGORY}.json" \
+    --item_path "${INFO_FILE}"
+
+echo "Done: ${CATEGORY} | temperature=${TEMPERATURE}"
+echo "Results: ${output_dir}/final_result_thinking_${CATEGORY}.json"
