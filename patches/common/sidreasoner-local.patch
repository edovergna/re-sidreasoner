@@ -0,0 +1,251 @@
+import ast
+import json
+import os
+import random
+
+import fire
+import numpy as np
+import pandas as pd
+import torch
+from tqdm import tqdm
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+
+if torch.cuda.is_available():
+    device = "cuda"
+else:
+    device = "cpu"
+
+
+DIRECT_SYSTEM = """Below is an instruction that describes a task, paired with an input that provides further context. Write a response that appropriately completes the request.
+Can you predict the next possible item that the user may expect?
+"""
+
+
+def get_hash(x):
+    return "-".join(str(_) for _ in x)
+
+
+def set_seed(seed):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed(seed)
+        torch.cuda.manual_seed_all(seed)
+
+
+def extract_input_ids(tokenized):
+    if hasattr(tokenized, "tolist"):
+        tokenized = tokenized.tolist()
+    if hasattr(tokenized, "input_ids"):
+        tokenized = tokenized.input_ids
+    if isinstance(tokenized, dict):
+        tokenized = tokenized["input_ids"]
+    if tokenized and isinstance(tokenized[0], list):
+        tokenized = tokenized[0]
+    return tokenized
+
+
+def parse_history(value):
+    if isinstance(value, list):
+        return value
+    return ast.literal_eval(value)
+
+
+def build_direct_prompt(history):
+    return (
+        "Can you predict the next possible item the user may expect, given the following chronological "
+        f"interaction history: {history}"
+    )
+
+
+def tokenize_direct_prompt(tokenizer, history, max_len):
+    messages = [
+        {"role": "system", "content": DIRECT_SYSTEM},
+        {"role": "user", "content": build_direct_prompt(history)},
+    ]
+    tokenized = tokenizer.apply_chat_template(
+        messages,
+        add_generation_prompt=True,
+        tokenize=True,
+        return_tensors=None,
+    )
+    input_ids = extract_input_ids(tokenized)
+    if len(input_ids) > max_len:
+        input_ids = input_ids[-max_len:]
+    return {"input_ids": input_ids, "attention_mask": [1] * len(input_ids)}
+
+
+def load_eval_rows(test_data_path):
+    data = pd.read_csv(test_data_path)
+    rows = []
+    for _, row in data.iterrows():
+        history_item_sid = parse_history(row["history_item_sid"])
+        history = ", ".join(history_item_sid)
+        target_sid = str(row["item_sid"])
+        rows.append(
+            {
+                "history_str": history,
+                "input": build_direct_prompt(history),
+                "output": target_sid,
+                "dedup": bool(history_item_sid and target_sid == history_item_sid[-1]),
+            }
+        )
+    return rows
+
+
+def build_sid_hash(tokenizer, info_file, base_model):
+    with open(info_file, "r") as f:
+        semantic_ids = [line.split("\t")[0].strip() for line in f.readlines()]
+
+    sid_texts = [f"{semantic_id}\n" for semantic_id in semantic_ids]
+    if "llama" in base_model.lower():
+        sid_token_ids = [tokenizer(text).input_ids[1:] for text in sid_texts]
+    else:
+        sid_token_ids = [tokenizer(text, add_special_tokens=False).input_ids for text in sid_texts]
+
+    hash_dict = {}
+    eos_id = tokenizer.eos_token_id
+    for ids in sid_token_ids:
+        ids = list(ids) + [eos_id]
+        for i in range(len(ids)):
+            hash_number = get_hash(ids[:i])
+            hash_dict.setdefault(hash_number, set()).add(ids[i])
+
+    return {key: list(value) for key, value in hash_dict.items()}
+
+
+def decode_sid_batches(
+    model,
+    tokenizer,
+    encodings,
+    sid_hash_dict,
+    batch_size,
+    num_beams,
+    max_new_tokens,
+    length_penalty,
+    padding_side,
+):
+    outputs = []
+    eos_id = tokenizer.eos_token_id
+    batches = [encodings[i : i + batch_size] for i in range(0, len(encodings), batch_size)]
+
+    for batch in tqdm(batches, desc="Strict direct SID decoding"):
+        max_len = max(len(item["input_ids"]) for item in batch)
+        padded_input_ids = []
+        attention_mask = []
+        for item in batch:
+            input_ids = item["input_ids"]
+            pad_len = max_len - len(input_ids)
+            if padding_side == "left":
+                padded_input_ids.append([tokenizer.pad_token_id] * pad_len + input_ids)
+                attention_mask.append([0] * pad_len + [1] * len(input_ids))
+            elif padding_side == "right":
+                padded_input_ids.append(input_ids + [tokenizer.pad_token_id] * pad_len)
+                attention_mask.append([1] * len(input_ids) + [0] * pad_len)
+            else:
+                raise ValueError("padding_side must be 'left' or 'right'")
+
+        def prefix_allowed_tokens_fn(_batch_id, input_ids):
+            generated = input_ids.tolist()[max_len:]
+            hash_number = get_hash(generated)
+            return sid_hash_dict.get(hash_number, [eos_id])
+
+        with torch.no_grad():
+            generation_output = model.generate(
+                input_ids=torch.tensor(padded_input_ids).to(device),
+                attention_mask=torch.tensor(attention_mask).to(device),
+                max_new_tokens=max_new_tokens,
+                num_beams=num_beams,
+                num_return_sequences=num_beams,
+                output_scores=True,
+                return_dict_in_generate=True,
+                early_stopping=True,
+                length_penalty=length_penalty,
+                prefix_allowed_tokens_fn=prefix_allowed_tokens_fn,
+            )
+
+        completions = generation_output.sequences[:, max_len:]
+        if "llama" in model.name_or_path.lower():
+            decoded = tokenizer.batch_decode(
+                completions,
+                skip_special_tokens=True,
+                clean_up_tokenization_spaces=False,
+            )
+        else:
+            decoded = tokenizer.batch_decode(completions, skip_special_tokens=True)
+        decoded = [text.split("Response:\n")[-1].strip() for text in decoded]
+        outputs.extend([decoded[i * num_beams : (i + 1) * num_beams] for i in range(len(decoded) // num_beams)])
+
+    return outputs
+
+
+def main(
+    base_model: str = "./pretrained/Video_Games/sidreasoner_ra_games",
+    info_file: str = "./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt",
+    category: str = "Video_Games",
+    test_data_path: str = "./data/Amazon/test/Video_Games_5_2016-10-2018-11.csv",
+    result_json_data: str = "./temp/test_results_Qwen3_strict_no_think.json",
+    batch_size: int = 8,
+    seed: int = 42,
+    length_penalty: float = 0.0,
+    max_new_tokens: int = 64,
+    num_beams: int = 10,
+    padding_side: str = "left",
+    max_len: int = 2560,
+    store_prompt_text: int = 0,
+):
+    os.environ["FLASH_ATTENTION"] = "1"
+    set_seed(seed)
+    print(f"Strict no-thinking direct SID evaluation for {category}")
+    print("No <think> prompt suffix is added; constrained decoding starts at the first generated token.")
+
+    tokenizer = AutoTokenizer.from_pretrained(base_model)
+    tokenizer.pad_token = tokenizer.eos_token
+    tokenizer.pad_token_id = tokenizer.eos_token_id
+    tokenizer.padding_side = padding_side
+    tokenizer.truncation_side = "left"
+
+    rows = load_eval_rows(test_data_path)
+    encodings = [tokenize_direct_prompt(tokenizer, row["history_str"], max_len) for row in rows]
+    sid_hash_dict = build_sid_hash(tokenizer, info_file, base_model)
+
+    model = AutoModelForCausalLM.from_pretrained(base_model, torch_dtype=torch.bfloat16, device_map="auto")
+    model.eval()
+    model = model.to(device)
+    model.config.pad_token_id = model.config.eos_token_id = tokenizer.eos_token_id
+    model.config.bos_token_id = tokenizer.bos_token_id
+
+    predictions = decode_sid_batches(
+        model=model,
+        tokenizer=tokenizer,
+        encodings=encodings,
+        sid_hash_dict=sid_hash_dict,
+        batch_size=batch_size,
+        num_beams=num_beams,
+        max_new_tokens=max_new_tokens,
+        length_penalty=length_penalty,
+        padding_side=padding_side,
+    )
+
+    for row, prediction, encoding in zip(rows, predictions, encodings):
+        row["ablation"] = "strict_no_think"
+        row["predict"] = prediction
+        row["decoding_config"] = {
+            "num_beams": num_beams,
+            "max_new_tokens": max_new_tokens,
+            "length_penalty": length_penalty,
+            "seed": seed,
+            "constraint": "raw_sid_from_first_generated_token",
+        }
+        if store_prompt_text:
+            row["prompt_cot"] = tokenizer.decode(encoding["input_ids"], skip_special_tokens=False)
+        row.pop("dedup", None)
+
+    with open(result_json_data, "w") as f:
+        json.dump(rows, f, indent=4)
+
+
+if __name__ == "__main__":
+    fire.Fire(main)
