+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=4
+#SBATCH --job-name=sid-S1-1p7B-games-sft
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=32
+#SBATCH --time=16:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+# No email notifications are enabled by default.
+# Email notifications may be configured with sbatch --mail-user.
+
+# S1 ablation (Video Games, 1.7B) = Phase A alignment SFT with MULTI-TASK data ONLY.
+# Mirrors scripts/sft_Qwen3_S1.sh (Office) exactly except for the Video_Games
+# category/paths and output dir, so the Games-vs-Office S1 comparison is clean.
+# Deliberately NO group_by_length / gradient_checkpointing: matches how the
+# Office S1 we are comparing against was trained (multitask data is short/uniform
+# so padding waste is small anyway).
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+
+CATEGORY="${CATEGORY:-Video_Games}"
+BASE_MODEL="${BASE_MODEL:-Qwen/Qwen3-1.7B}"
+TRAIN_FILE="${TRAIN_FILE:-./data/Amazon/train/Video_Games_5_2016-10-2018-11.csv}"
+EVAL_FILE="${EVAL_FILE:-./data/Amazon/valid/Video_Games_5_2016-10-2018-11.csv}"
+TEST_FILE="${TEST_FILE:-./data/Amazon/test/Video_Games_5_2016-10-2018-11.csv}"
+INFO_FILE="${INFO_FILE:-./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt}"
+OUTPUT_DIR="${OUTPUT_DIR:-./output_dir/Video_Games_stage1_sft_Qwen3-1.7B_S1}"
+RUN_NAME="${RUN_NAME:-Video_Games_stage1_sft_Qwen3-1.7B_S1}"
+LOG_FILE="${LOG_FILE:-./logs/${RUN_NAME}.txt}"
+CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3}"
+NPROC_PER_NODE="${NPROC_PER_NODE:-4}"
+MASTER_PORT="${MASTER_PORT:-12351}"
+
+mkdir -p ./logs ./output_dir
+
+{
+echo "${TRAIN_FILE} ${EVAL_FILE} ${INFO_FILE} ${TEST_FILE}"
+
+CUDA_VISIBLE_DEVICES="${CUDA_DEVICES}" ${TORCHRUN_CMD} --nproc_per_node "${NPROC_PER_NODE}" \
+    --master_port "${MASTER_PORT}" \
+    sft_Qwen3.py \
+    --base_model "${BASE_MODEL}" \
+    --batch_size 1024 \
+    --micro_batch_size 16 \
+    --train_file "${TRAIN_FILE}" \
+    --eval_file "${EVAL_FILE}" \
+    --output_dir "${OUTPUT_DIR}" \
+    --wandb_project MiniOneRec \
+    --wandb_run_name "${RUN_NAME}" \
+    --category "${CATEGORY}" \
+    --train_from_scratch False \
+    --seed 42 \
+    --sid_index_path "./data/Amazon/index/${CATEGORY}.index.json" \
+    --item_meta_path "./data/Amazon/index/${CATEGORY}.item.json" \
+    --llm_generated_data_path None \
+    --llm_generated_sequence_path None \
+    --general_reasoning_path None \
+    --mask_assistant True \
+    "$@"
+} 2>&1 | tee "${LOG_FILE}"
