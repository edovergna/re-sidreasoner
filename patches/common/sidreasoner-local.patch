+category_item_file() {
+    local category="$1"
+    echo "./data/Amazon/index/${category}.item.json"
+}
+
+category_index_file() {
+    local category="$1"
+    echo "./data/Amazon/index/${category}.index.json"
+}
+
+mode_label() {
+    local mode="$1"
+    case "${mode}" in
+        original_thinking) echo "Original thinking" ;;
+        strict_no_think) echo "Strict no-think" ;;
+        no_step) echo "No step-by-step" ;;
+        preference_summary) echo "Preference summary" ;;
+        *) echo "${mode}" ;;
+    esac
+}
+
+run_sharded_eval() {
+    local category="$1"
+    local checkpoint="$2"
+    local mode="$3"
+    local test_file="$4"
+    local info_file="$5"
+    local item_file="$6"
+    local index_file="$7"
+    local temp_dir="$8"
+
+    pids=()
+    for gpu in ${CUDA_LIST}; do
+        if [[ ! -f "${temp_dir}/${gpu}.csv" ]]; then
+            echo "Warning: split file missing for GPU ${gpu}: ${temp_dir}/${gpu}.csv"
+            continue
+        fi
+
+        if [[ "${mode}" == "original_thinking" ]]; then
+            master_port=$((26000 + (${SLURM_JOB_ID:-0} % 10000) + gpu))
+            MASTER_ADDR=127.0.0.1 MASTER_PORT=${master_port} CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                --base_model "${checkpoint}" \
+                --info_file "${info_file}" \
+                --category "${category}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --item_file "${item_file}" \
+                --index_file "${index_file}" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --batch_size "${THINKING_BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --num_return_sequences "${NUM_RETURN_SEQUENCES}" \
+                --max_new_tokens "${THINKING_MAX_NEW_TOKENS}" \
+                --length_penalty "${LENGTH_PENALTY}" \
+                --decoding_method beam \
+                --temperature 0.0 \
+                --reasoning_temperature "${REASONING_TEMPERATURE}" \
+                --top_p "${TOP_P}" \
+                --top_k "${TOP_K}" \
+                --seed "${SEED}" &
+        elif [[ "${mode}" == "strict_no_think" ]]; then
+            CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_strict_no_think.py \
+                --base_model "${checkpoint}" \
+                --info_file "${info_file}" \
+                --category "${category}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --batch_size "${STRICT_BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --max_new_tokens "${SID_MAX_NEW_TOKENS}" \
+                --length_penalty "${LENGTH_PENALTY}" \
+                --seed "${SEED}" &
+        elif [[ "${mode}" == "no_step" || "${mode}" == "preference_summary" ]]; then
+            local reasoning_tokens=0
+            if [[ "${mode}" == "preference_summary" ]]; then
+                reasoning_tokens="${PREFERENCE_SUMMARY_REASONING_TOKENS}"
+            fi
+            CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./utils/evaluate_prompt_ablation.py \
+                --base_model "${checkpoint}" \
+                --info_file "${info_file}" \
+                --category "${category}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --ablation "${mode}" \
+                --batch_size "${PROMPT_BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --max_new_tokens "${SID_MAX_NEW_TOKENS}" \
+                --reasoning_max_new_tokens "${reasoning_tokens}" \
+                --length_penalty "${LENGTH_PENALTY}" \
+                --reasoning_temperature "${REASONING_TEMPERATURE}" \
+                --top_p "${TOP_P}" \
+                --top_k "${TOP_K}" \
+                --max_len "${MAX_LEN}" \
+                --vllm_max_model_len "${VLLM_MAX_MODEL_LEN}" \
+                --seed "${SEED}" &
+        else
+            echo "Error: unknown mode ${mode}"
+            exit 1
+        fi
+        pids+=("$!")
+    done
+
+    failed=0
+    for pid in "${pids[@]}"; do
+        if ! wait "${pid}"; then
+            failed=1
+        fi
+    done
+    if (( failed )); then
+        echo "Error: at least one shard failed for ${category} / ${mode}."
+        exit 1
+    fi
+}
+
+{
+echo "Appendix prompt ablation table"
+echo "Eval pairs: ${EVAL_PAIRS}"
+echo "Modes: ${MODES}"
+echo "Seed: ${SEED}"
+echo "Decoding: deterministic constrained beam${NUM_BEAMS}"
+echo "Reasoning temperature: ${REASONING_TEMPERATURE}"
+echo "Temp root: ${TMP_ROOT}"
+echo "Result root: ${RESULT_ROOT}"
+echo "Manifest: ${SUMMARY_MANIFEST}"
+echo "Python: ${PYTHON_CMD}"
+echo "============================================================"
+
+for pair in ${EVAL_PAIRS}; do
+    category="${pair%%:*}"
+    checkpoint="${pair#*:}"
+    test_file="$(category_test_file "${category}")"
+    info_file="$(category_info_file "${category}")"
+    item_file="$(category_item_file "${category}")"
+    index_file="$(category_index_file "${category}")"
+
+    for required_path in "${checkpoint}" "${test_file}" "${info_file}" "${item_file}" "${index_file}"; do
+        if [[ ! -e "${required_path}" ]]; then
+            echo "Error: required path not found: ${required_path}"
+            exit 1
+        fi
+    done
+
+    for mode in ${MODES}; do
+        run_name="${category}_${mode}_beam${NUM_BEAMS}_seed${SEED}"
+        temp_dir="${TMP_ROOT}/${run_name}"
+        output_dir="${RESULT_ROOT}/${category}/${mode}_beam${NUM_BEAMS}_seed${SEED}"
+        output_json="${output_dir}/final_result_${mode}_${category}.json"
+
+        echo
+        echo "============================================================"
+        echo "Running ${run_name}"
+        echo "Checkpoint: ${checkpoint}"
+        echo "============================================================"
+
+        mkdir -p "${temp_dir}" "${output_dir}"
+        ${PYTHON_CMD} ./split.py \
+            --input_path "${test_file}" \
+            --output_path "${temp_dir}" \
+            --cuda_list "${CUDA_LIST_CSV}" \
+            --num_samples "${NUM_SAMPLES}"
+
+        run_sharded_eval "${category}" "${checkpoint}" "${mode}" "${test_file}" "${info_file}" "${item_file}" "${index_file}" "${temp_dir}"
+
+        actual_cuda_list=""
+        for gpu in ${CUDA_LIST}; do
+            if [[ -f "${temp_dir}/${gpu}.json" ]]; then
+                actual_cuda_list="${actual_cuda_list}${gpu},"
+            fi
+        done
+        actual_cuda_list="${actual_cuda_list%,}"
+        if [[ -z "${actual_cuda_list}" ]]; then
+            echo "Error: no result shards were produced for ${run_name}"
+            exit 1
+        fi
+
+        ${PYTHON_CMD} ./merge.py \
+            --input_path "${temp_dir}" \
+            --output_path "${output_json}" \
+            --cuda_list "${actual_cuda_list}"
+
+        ${PYTHON_CMD} ./calc.py \
+            --path "${output_json}" \
+            --item_path "${info_file}"
+
+        printf "%s\t%s\t%s\t%s\n" "$(mode_label "${mode}")" "${category}" "${output_json}" "${info_file}" >> "${SUMMARY_MANIFEST}"
+        echo "Done. Results saved to: ${output_json}"
+    done
+done
+
+echo
+echo "Appendix prompt-ablation summary:"
+${PYTHON_CMD} ./utils/summarize_labeled_eval_table.py \
+    --manifest_path "${SUMMARY_MANIFEST}" \
+    --output_path "${SUMMARY_OUTPUT}" \
+    --title "Appendix Prompt Ablations on Final Checkpoints" \
+    --topk "1,3,5,10"
+
+echo "Summary saved to: ${SUMMARY_OUTPUT}"
+echo "Manifest saved to: ${SUMMARY_MANIFEST}"
+} 2>&1 | tee "${LOG_FILE}"
diff --git a/final_scripts/rq2_components/evaluate_reasoning_ablation.sh b/final_scripts/rq2_components/evaluate_reasoning_ablation.sh
new file mode 100644
index 0000000..12013aa
--- /dev/null
+++ b/final_scripts/rq2_components/evaluate_reasoning_ablation.sh
@@ -0,0 +1,154 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=rq2-reasoning
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+if [[ -x "${PWD}/.venv/bin/python" ]]; then
+    PYTHON_CMD="${PWD}/.venv/bin/python"
+    export PYTHON_CMD
+fi
+
+CHECKPOINT_SPECS="${CHECKPOINT_SPECS:-\
+Video_Games:ra_pre_rl:./pretrained/Video_Games/sidreasoner_ra_games \
+Video_Games:rl_post_grpo:./pretrained/Video_Games/Qwen3-1.7B_base_e2e-RA-GeneralReason_stepRule-smalllR_Games/actor_merged \
+Office_Products:ra_pre_rl:./pretrained/Office_Products/sidreasoner_ra_office \
+Office_Products:rl_post_grpo:./pretrained/Office_Products/Qwen3-1.7B_base_e2e-General_stepRule-smalllR_Office_Products/actor_merged \
+Industrial_and_Scientific:rl_post_grpo:./pretrained/Industrial_and_Scientific/Qwen3-1.7B_base_e2e-gptgen-general-ep1_stepRule-smalllR_Industrial_and_Scientific/actor_merged}"
+MODES="${MODES:-thinking strict_no_think}"
+SEEDS="${SEEDS:-42}"
+
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+NUM_SAMPLES="${NUM_SAMPLES:--1}"
+THINKING_BATCH_SIZE="${THINKING_BATCH_SIZE:-2}"
+STRICT_BATCH_SIZE="${STRICT_BATCH_SIZE:-8}"
+NUM_BEAMS="${NUM_BEAMS:-10}"
+NUM_RETURN_SEQUENCES="${NUM_RETURN_SEQUENCES:-10}"
+THINKING_MAX_NEW_TOKENS="${THINKING_MAX_NEW_TOKENS:-1024}"
+STRICT_MAX_NEW_TOKENS="${STRICT_MAX_NEW_TOKENS:-64}"
+RESULT_ROOT="${RESULT_ROOT:-./results/rq2_reasoning_ablation}"
+TMP_ROOT="${TMP_ROOT:-${TMPDIR:-/tmp}/${USER:-user}/SIDReasoner_tmp/rq2_reasoning_ablation/${SLURM_JOB_ID:-manual}}"
+SUMMARY_MANIFEST="${SUMMARY_MANIFEST:-${RESULT_ROOT}/manifest_${SLURM_JOB_ID:-manual}.tsv}"
+SUMMARY_OUTPUT="${SUMMARY_OUTPUT:-${RESULT_ROOT}/summary_${SLURM_JOB_ID:-manual}.md}"
+LOG_FILE="${LOG_FILE:-./logs/rq2_reasoning_ablation_${SLURM_JOB_ID:-manual}.log}"
+
+mkdir -p ./logs ./slurm_output "${RESULT_ROOT}" "${TMP_ROOT}"
+printf "" > "${SUMMARY_MANIFEST}"
+
+dataset_files() {
+    local dataset="$1"
+    TEST_FILE="./data/Amazon/test/${dataset}_5_2016-10-2018-11.csv"
+    INFO_FILE="./data/Amazon/info/${dataset}_5_2016-10-2018-11.txt"
+    ITEM_FILE="./data/Amazon/index/${dataset}.item.json"
+    INDEX_FILE="./data/Amazon/index/${dataset}.index.json"
+}
+
+run_eval() {
+    local dataset="$1"
+    local checkpoint_label="$2"
+    local checkpoint_path="$3"
+    local mode="$4"
+    local seed="$5"
+
+    dataset_files "${dataset}"
+    local run_name="${dataset}_${checkpoint_label}_${mode}_beam${NUM_BEAMS}_seed${seed}"
+    local temp_dir="${TMP_ROOT}/${run_name}"
+    local output_dir="${RESULT_ROOT}/${dataset}/${checkpoint_label}/${mode}_beam${NUM_BEAMS}_seed${seed}"
+    local output_json="${output_dir}/final_result_${mode}_${dataset}.json"
+
+    mkdir -p "${temp_dir}" "${output_dir}"
+    ${PYTHON_CMD} ./split.py --input_path "${TEST_FILE}" --output_path "${temp_dir}" --cuda_list "${CUDA_LIST_CSV}" --num_samples "${NUM_SAMPLES}"
+
+    pids=()
+    for gpu in ${CUDA_LIST}; do
+        [[ -f "${temp_dir}/${gpu}.csv" ]] || continue
+        if [[ "${mode}" == "thinking" ]]; then
+            master_port=$((25000 + (${SLURM_JOB_ID:-0} % 10000) + gpu))
+            MASTER_ADDR=127.0.0.1 MASTER_PORT=${master_port} CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                --base_model "${checkpoint_path}" \
+                --info_file "${INFO_FILE}" \
+                --category "${dataset}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --item_file "${ITEM_FILE}" \
+                --index_file "${INDEX_FILE}" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --batch_size "${THINKING_BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --num_return_sequences "${NUM_RETURN_SEQUENCES}" \
+                --max_new_tokens "${THINKING_MAX_NEW_TOKENS}" \
+                --length_penalty 0.0 \
+                --decoding_method beam \
+                --temperature 0.0 \
+                --reasoning_temperature 0.0 \
+                --top_p 1.0 \
+                --top_k 0 \
+                --seed "${seed}" &
+        else
+            CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_strict_no_think.py \
+                --base_model "${checkpoint_path}" \
+                --info_file "${INFO_FILE}" \
+                --category "${dataset}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --batch_size "${STRICT_BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --max_new_tokens "${STRICT_MAX_NEW_TOKENS}" \
+                --length_penalty 0.0 \
+                --seed "${seed}" &
+        fi
+        pids+=("$!")
+    done
+    failed=0
+    for pid in "${pids[@]}"; do
+        if ! wait "${pid}"; then
+            failed=1
+        fi
+    done
+    (( failed == 0 )) || { echo "Shard failed for ${run_name}"; exit 1; }
+
+    actual_cuda_list=""
+    for gpu in ${CUDA_LIST}; do
+        [[ -f "${temp_dir}/${gpu}.json" ]] && actual_cuda_list="${actual_cuda_list}${gpu},"
+    done
+    actual_cuda_list="${actual_cuda_list%,}"
+    ${PYTHON_CMD} ./merge.py --input_path "${temp_dir}" --output_path "${output_json}" --cuda_list "${actual_cuda_list}"
+    ${PYTHON_CMD} ./calc.py --path "${output_json}" --item_path "${INFO_FILE}"
+    printf "%s / %s\t%s\t%s\t%s\n" "${checkpoint_label}" "${mode}" "${dataset}" "${output_json}" "${INFO_FILE}" >> "${SUMMARY_MANIFEST}"
+}
+
+{
+for spec in ${CHECKPOINT_SPECS}; do
+    IFS=: read -r dataset checkpoint_label checkpoint_path <<< "${spec}"
+    dataset_files "${dataset}"
+    for required in "${checkpoint_path}/config.json" "${TEST_FILE}" "${INFO_FILE}" "${ITEM_FILE}" "${INDEX_FILE}"; do
+        [[ -e "${required}" ]] || { echo "Missing ${required}"; exit 1; }
+    done
+    for seed in ${SEEDS}; do
+        for mode in ${MODES}; do
+            echo "Running ${dataset} / ${checkpoint_label} / ${mode} / seed ${seed}"
+            run_eval "${dataset}" "${checkpoint_label}" "${checkpoint_path}" "${mode}" "${seed}"
+        done
+    done
+done
+
+${PYTHON_CMD} ./utils/summarize_labeled_eval_table.py \
+    --manifest_path "${SUMMARY_MANIFEST}" \
+    --output_path "${SUMMARY_OUTPUT}" \
+    --title "RQ2: Thinking versus strict no-think" \
+    --topk "1,3,5,10"
+echo "Summary saved to ${SUMMARY_OUTPUT}"
+} 2>&1 | tee "${LOG_FILE}"
diff --git a/final_scripts/rq2_components/train_ra_continuations.sh b/final_scripts/rq2_components/train_ra_continuations.sh
new file mode 100644
index 0000000..ca82b51
--- /dev/null
+++ b/final_scripts/rq2_components/train_ra_continuations.sh
@@ -0,0 +1,137 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=4
+#SBATCH --job-name=rq2-ra-cont
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=32
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+
+DATASETS="${DATASETS:-Video_Games Office_Products}"
+CONTINUATIONS="${CONTINUATIONS:-extra_sft extra_ra}"
+SCRATCH_OUTPUT_ROOT="${SCRATCH_OUTPUT_ROOT:-./output_dir/continuations}"
+CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3}"
+NPROC_PER_NODE="${NPROC_PER_NODE:-4}"
+MASTER_PORT_BASE="${MASTER_PORT_BASE:-29520}"
+LEARNING_RATE="${LEARNING_RATE:-1e-5}"
+BATCH_SIZE="${BATCH_SIZE:-1024}"
+MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-8}"
+SEED="${SEED:-42}"
+
+mkdir -p ./logs ./slurm_output "${SCRATCH_OUTPUT_ROOT}"
+
+dataset_paths() {
+    local dataset="$1"
+    BASE_MODEL="./pretrained/${dataset}/sidreasoner_ra_games"
+    if [[ "${dataset}" == "Office_Products" ]]; then
+        BASE_MODEL="./pretrained/Office_Products/sidreasoner_ra_office"
+    fi
+    TRAIN_FILE="./data/Amazon/train/${dataset}_5_2016-10-2018-11.csv"
+    EVAL_FILE="./data/Amazon/valid/${dataset}_5_2016-10-2018-11.csv"
+    ITEM_FILE="./data/Amazon/index/${dataset}.item.json"
+    INDEX_FILE="./data/Amazon/index/${dataset}.index.json"
+    REASONING_TRAIN_FILE="./data/Amazon/index/${dataset}.integrated_narrative.csv"
+}
+
+continuation_config() {
+    local dataset="$1"
+    local continuation="$2"
+    case "${continuation}" in
+        extra_sft)
+            NUM_EPOCHS="${NUM_EPOCHS:-3}"
+            LOAD_BEST_MODEL_AT_END="True"
+            SAVE_TOTAL_LIMIT=""
+            OUTPUT_DIR="${OUTPUT_DIR:-${SCRATCH_OUTPUT_ROOT}/${dataset}_ra_extra_sft_3epochs_Qwen3-1.7B}"
+            RUN_NAME="${RUN_NAME:-${dataset}_ra_extra_sft_3epochs_Qwen3-1.7B}"
+            ;;
+        extra_ra)
+            NUM_EPOCHS="${NUM_EPOCHS:-10}"
+            LOAD_BEST_MODEL_AT_END="True"
+            SAVE_TOTAL_LIMIT="1"
+            OUTPUT_DIR="${OUTPUT_DIR:-${SCRATCH_OUTPUT_ROOT}/${dataset}_ra_extra_sft_10epochs_Qwen3-1.7B}"
+            RUN_NAME="${RUN_NAME:-${dataset}_ra_extra_sft_10epochs_Qwen3-1.7B}"
+            ;;
+        *)
+            echo "Unknown continuation: ${continuation}" >&2
+            exit 1
+            ;;
+    esac
+}
+
+run_one() {
+    local dataset="$1"
+    local continuation="$2"
+    local index="$3"
+
+    dataset_paths "${dataset}"
+    continuation_config "${dataset}" "${continuation}"
+    local log_file="./logs/${RUN_NAME}.txt"
+    local master_port=$((MASTER_PORT_BASE + index))
+
+    for required_path in "${BASE_MODEL}/config.json" "${TRAIN_FILE}" "${EVAL_FILE}" "${ITEM_FILE}" "${INDEX_FILE}" "${REASONING_TRAIN_FILE}"; do
+        if [[ ! -e "${required_path}" ]]; then
+            echo "Error: required path not found: ${required_path}"
+            exit 1
+        fi
+    done
+    mkdir -p "${OUTPUT_DIR}"
+
+    echo
+    echo "============================================================"
+    echo "Running ${dataset} / ${continuation}"
+    echo "Base model: ${BASE_MODEL}"
+    echo "Output dir: ${OUTPUT_DIR}"
+    echo "Epochs: ${NUM_EPOCHS}"
+    echo "Load best model at end: ${LOAD_BEST_MODEL_AT_END}"
+    echo "============================================================"
+
+    save_limit_args=()
+    if [[ -n "${SAVE_TOTAL_LIMIT}" ]]; then
+        save_limit_args=(--save_total_limit "${SAVE_TOTAL_LIMIT}")
+    fi
+
+    CUDA_VISIBLE_DEVICES="${CUDA_DEVICES}" ${TORCHRUN_CMD} --nproc_per_node "${NPROC_PER_NODE}" --master_port "${master_port}" \
+        sft_reasoning_activation.py \
+        --base_model "${BASE_MODEL}" \
+        --batch_size "${BATCH_SIZE}" \
+        --micro_batch_size "${MICRO_BATCH_SIZE}" \
+        --num_epochs "${NUM_EPOCHS}" \
+        --learning_rate "${LEARNING_RATE}" \
+        --train_file "${TRAIN_FILE}" \
+        --eval_file "${EVAL_FILE}" \
+        --output_dir "${OUTPUT_DIR}" \
+        --wandb_project MiniOneRec \
+        --wandb_run_name "${RUN_NAME}" \
+        --report_to none \
+        --category "${dataset}" \
+        --train_from_scratch False \
+        --seed "${SEED}" \
+        --sid_index_path "${INDEX_FILE}" \
+        --item_meta_path "${ITEM_FILE}" \
+        --reasoning_train_file "${REASONING_TRAIN_FILE}" \
+        --train_new_token_embeddings_only False \
+        --load_best_model_at_end "${LOAD_BEST_MODEL_AT_END}" \
+        --save_only_model True \
+        "${save_limit_args[@]}" \
+        "$@" 2>&1 | tee "${log_file}"
+}
+
+idx=0
+for dataset in ${DATASETS}; do
+    for continuation in ${CONTINUATIONS}; do
+        run_one "${dataset}" "${continuation}" "${idx}" "$@"
+        idx=$((idx + 1))
+        unset OUTPUT_DIR RUN_NAME NUM_EPOCHS
+    done
+done
diff --git a/final_scripts/rq4_model_size/RL_training_S3_0p6B_Games.sh b/final_scripts/rq4_model_size/RL_training_S3_0p6B_Games.sh
new file mode 100644
index 0000000..e144a01
--- /dev/null
