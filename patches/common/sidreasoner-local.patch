@@ -0,0 +1,73 @@
+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=4
+#SBATCH --job-name=sid-S3-0p6B-games-rl
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=32
+#SBATCH --time=48:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+# S3 Phase C: GRPO from the S3 reasoning-activation checkpoint.
+
+set -euo pipefail
+set -x
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+
+n_gpus_per_node="${N_GPUS_PER_NODE:-4}"
+nnodes="${NNODES:-1}"
+experiment_name="${EXPERIMENT_NAME:-Video_Games_stage3_rl_Qwen3-0.6B_S3}"
+stage2_checkpoint="${STAGE2_CHECKPOINT:-./output_dir/Video_Games_stage2_reasoning_activation_Qwen3-0.6B_S3/final_checkpoint}"
+log_file="${LOG_FILE:-./logs/${experiment_name}.log}"
