diff --git a/utils/check_leakage.py b/utils/check_leakage.py
new file mode 100644
index 0000000..8d78928
--- /dev/null
+++ b/utils/check_leakage.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python
+"""Data-leakage checks for the SIDReasoner reproduction.
+
+All of train/valid/test CSVs and the activation narrative CSV share the same
+keys: history_item_sid (list of SID strings) + item_sid (target SID). A correct
+temporal leave-one-out split means a test example (history -> target) must NEVER
+appear in the training-side data. This script flags any overlap.
+
+Checks:
+  1. EXACT (history, target) overlap: test vs train / valid / narrative.
+     Any hit = the model trained on the exact test example. Hard leak.
+  2. Test history reused as a training history (same context, regardless of
+     target) -> same user-position seen in training. Suspicious.
+  3. Answer-in-reasoning: fraction of narrative rows whose reasoning_path text
+     literally contains the target item_sid. Not test leakage, but explains an
+     inflated pre-RL number (the cold-start trains on answer-revealing CoT).
+  4. Trivial-dedup: fraction of test rows whose target == last history item.
+
+Usage:
+  python scripts/check_leakage.py --category Office_Products
+  python scripts/check_leakage.py --category Video_Games
+"""
+import os
+import ast
+import argparse
+import pandas as pd
+
+
+def load(path):
+    df = pd.read_csv(path)
+    pairs, hists = set(), set()
+    for h, t in zip(df["history_item_sid"], df["item_sid"]):
+        try:
+            hist = tuple(ast.literal_eval(h))
+        except Exception:
+            continue
+        tgt = str(t).strip()
+        pairs.add((hist, tgt))
+        hists.add(hist)
+    return df, pairs, hists
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data_dir", default="./data/Amazon")
+    ap.add_argument("--category", default="Office_Products")
+    ap.add_argument("--suffix", default="_5_2016-10-2018-11")
+    args = ap.parse_args()
+
+    c, sfx = args.category, args.suffix
+    train_f = os.path.join(args.data_dir, "train", f"{c}{sfx}.csv")
+    valid_f = os.path.join(args.data_dir, "valid", f"{c}{sfx}.csv")
+    test_f = os.path.join(args.data_dir, "test", f"{c}{sfx}.csv")
+    narr_f = os.path.join(args.data_dir, "index", f"{c}.integrated_narrative.csv")
+
+    print(f"=== Leakage check: {c} ===")
+    _, test_pairs, test_hists = load(test_f)
+    _, train_pairs, train_hists = load(train_f)
+    _, valid_pairs, _ = load(valid_f)
+    print(f"test pairs={len(test_pairs)}  train pairs={len(train_pairs)}  valid pairs={len(valid_pairs)}")
+
+    # 1. exact (history,target) overlap
+    def pct(n):
+        return f"{n} ({100.0*n/max(len(test_pairs),1):.2f}% of test)"
+    print("\n[1] EXACT (history -> target) overlap with test:")
+    print(f"  test ∩ train : {pct(len(test_pairs & train_pairs))}   <-- hard leak if > 0")
+    print(f"  test ∩ valid : {pct(len(test_pairs & valid_pairs))}")
+
+    # 2. test history reused as a training history (any target)
+    print("\n[2] Test history also appears as a TRAIN history (any target):")
+    print(f"  {pct(len(test_hists & train_hists))}   <-- suspicious if high")
+
+    # 3 + narrative checks
+    if os.path.exists(narr_f):
+        narr = pd.read_csv(narr_f)
+        narr_pairs, narr_hists = set(), set()
+        ans_in_reason = 0
+        n_rows = 0
+        for h, t, r in zip(narr["history_item_sid"], narr["item_sid"], narr["reasoning_path"]):
+            try:
+                hist = tuple(ast.literal_eval(h))
+            except Exception:
+                continue
+            tgt = str(t).strip()
+            narr_pairs.add((hist, tgt))
+            narr_hists.add(hist)
+            n_rows += 1
+            if isinstance(r, str) and tgt and tgt in r:
+                ans_in_reason += 1
+        print(f"\n[narrative] rows={n_rows}  pairs={len(narr_pairs)}")
+        print("[1b] EXACT (history -> target) overlap, test ∩ narrative:")
+        print(f"  {pct(len(test_pairs & narr_pairs))}   <-- activation-data leak if > 0")
+        print("[2b] Test history also appears as a NARRATIVE history:")
+        print(f"  {pct(len(test_hists & narr_hists))}")
+        print("[3] Answer-in-reasoning (reasoning_path contains the target SID):")
+        print(f"  {ans_in_reason}/{n_rows} ({100.0*ans_in_reason/max(n_rows,1):.2f}%)   "
+              f"<-- inflates pre-RL if high")
+    else:
+        print(f"\n[narrative] not found at {narr_f} (skipping narrative checks)")
+
+    # 4. trivial dedup in test
+    _, _, _ = None, None, None
+    tdf = pd.read_csv(test_f)
+    dup = 0
+    n = 0
+    for h, t in zip(tdf["history_item_sid"], tdf["item_sid"]):
+        try:
+            hist = ast.literal_eval(h)
+        except Exception:
+            continue
+        n += 1
+        if hist and str(hist[-1]).strip() == str(t).strip():
+            dup += 1
+    print("\n[4] Trivial dedup (test target == last history item):")
+    print(f"  {dup}/{n} ({100.0*dup/max(n,1):.2f}%)   <-- inflates HR@1 if high")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/collect_eval_metrics.py b/utils/collect_eval_metrics.py
new file mode 100644
index 0000000..11971c6
--- /dev/null
+++ b/utils/collect_eval_metrics.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python
+"""Collect Figure-5 data from eval result JSONs.
+
+For each ./results/<exp>/final_result_thinking_<CATEGORY>.json this computes
+HR@k / NDCG@k (same logic as calc.py) and the average chain-of-thought length
+(from the per-sample "cot" field), then writes a tidy CSV sorted by RL step.
+
+Step is parsed from the experiment dir name:
+  ...global_step_300...      -> 300
+  ...stage2...               -> 0   (pre-RL reasoning-activation baseline)
+
+Usage:
+  python scripts/collect_eval_metrics.py \
+      --results_dir ./results --category Video_Games \
+      --info_file ./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt \
+      --tokenizer ./output_dir/Video_Games_stage2_reasoning_activation_Qwen3-0.6B_S3/final_checkpoint \
+      --out ./results/figure5_0p6B.csv
+"""
+import os
+import re
+import csv
+import json
+import glob
+import math
+import argparse
+
+
+def build_item_dict(info_file):
+    if info_file.endswith(".txt"):
+        info_file = info_file[:-4]
+    with open(f"{info_file}.txt", "r") as f:
+        items = f.readlines()
+    item_names = [_.split("\t")[0].strip() for _ in items]
+    item_dict = {}
+    for idx, name in enumerate(item_names):
+        item_dict.setdefault(name, []).append(idx)
+    return item_dict
+
+
+def metrics_for_file(path, item_dict, topk_list=(1, 3, 5, 10, 20, 50)):
+    with open(path, "r") as f:
+        data = json.load(f)
+
+    preds = [[p.strip('"\n').strip() for p in s["predict"]] for s in data]
+    n_beam = len(preds[0]) if preds else 0
+    valid_topk = [k for k in topk_list if k <= n_beam]
+    ndcg = {k: 0.0 for k in valid_topk}
+    hr = {k: 0.0 for k in valid_topk}
+
+    for index, beams in enumerate(preds):
+        out = data[index]["output"]
+        target = (out[0] if isinstance(out, list) else out).strip(' \n"')
+        min_id = 1_000_000
+        for i, b in enumerate(beams):
+            if b == target:
+                min_id = i
+                break
+        for k in valid_topk:
+            if min_id < k:
+                ndcg[k] += 1.0 / math.log(min_id + 2)
+                hr[k] += 1.0
+
+    n = len(preds) if preds else 1
+    norm = 1.0 / math.log(2)
+    ndcg = {k: ndcg[k] / n / norm for k in valid_topk}
+    hr = {k: hr[k] / n for k in valid_topk}
+    return hr, ndcg, n
+
+
+def cot_lengths(path, tok):
+    """Average CoT length in tokens (if tokenizer given) and in words."""
+    with open(path, "r") as f:
+        data = json.load(f)
+    cots = [s.get("cot", "") or "" for s in data]
+    words = [len(c.split()) for c in cots]
+    avg_words = sum(words) / len(words) if words else 0.0
+    avg_tokens = float("nan")
+    if tok is not None and cots:
+        toks = [len(tok(c, add_special_tokens=False)["input_ids"]) for c in cots]
+        avg_tokens = sum(toks) / len(toks)
+    return avg_tokens, avg_words
+
+
+def parse_step(name):
+    m = re.search(r"global_step_(\d+)", name)
+    if m:
+        return int(m.group(1))
+    if "stage2" in name or "reasoning_activation" in name:
+        return 0
+    return None
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--results_dir", default="./results")
+    ap.add_argument("--category", default="Video_Games")
+    ap.add_argument("--info_file", required=True)
+    ap.add_argument("--tokenizer", default=None,
+                    help="HF model/tokenizer path for token-based CoT length (optional)")
+    ap.add_argument("--out", default="./results/figure5.csv")
+    ap.add_argument("--name_filter", default="",
+                    help="only include result dirs whose name contains this substring "
+                         "(e.g. '4B' to isolate one model size; avoids step collisions across sweeps)")
+    ap.add_argument("--exclude", default="",
+                    help="comma-separated substrings; result dirs containing ANY are dropped "
+                         "(e.g. 'act_1ep,reasoning_activation' to keep only the GRPO-base activation as step 0)")
+    args = ap.parse_args()
+    exclude_terms = [x for x in args.exclude.split(",") if x]
+
+    tok = None
+    if args.tokenizer:
+        try:
+            from transformers import AutoTokenizer
+            tok = AutoTokenizer.from_pretrained(args.tokenizer, trust_remote_code=True)
+        except Exception as e:
+            print(f"[warn] could not load tokenizer ({e}); falling back to word counts")
+
+    item_dict = build_item_dict(args.info_file)
+    pattern = os.path.join(args.results_dir, "*", f"final_result_thinking_{args.category}.json")
+
+    rows = []
+    for path in sorted(glob.glob(pattern)):
+        exp = os.path.basename(os.path.dirname(path))
+        if args.name_filter and args.name_filter not in exp:
+            continue
+        if any(t in exp for t in exclude_terms):
+            continue
+        step = parse_step(exp)
+        if step is None:
+            print(f"[skip] cannot parse step from {exp}")
+            continue
+        hr, ndcg, n = metrics_for_file(path, item_dict)
+        avg_tok, avg_words = cot_lengths(path, tok)
+        rows.append({
+            "step": step,
+            "exp": exp,
+            "n": n,
+            "HR@1": hr.get(1, float("nan")),
+            "HR@5": hr.get(5, float("nan")),
+            "HR@10": hr.get(10, float("nan")),
+            "NDCG@5": ndcg.get(5, float("nan")),
+            "NDCG@10": ndcg.get(10, float("nan")),
+            "cot_tokens": avg_tok,
+            "cot_words": avg_words,
+        })
+
+    rows.sort(key=lambda r: r["step"])
+    if not rows:
+        print(f"No result files found under {pattern}")
+        return
+
+    fields = ["step", "exp", "n", "HR@1", "HR@5", "HR@10",
+              "NDCG@5", "NDCG@10", "cot_tokens", "cot_words"]
+    with open(args.out, "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=fields)
+        w.writeheader()
+        for r in rows:
+            w.writerow(r)
+
+    # pretty print
+    print(f"\nWrote {args.out}\n")
+    print(f"{'step':>6} {'HR@10':>8} {'NDCG@10':>8} {'cot_tok':>8} {'cot_wrd':>8}")
+    for r in rows:
+        print(f"{r['step']:>6} {r['HR@10']:>8.4f} {r['NDCG@10']:>8.4f} "
+              f"{r['cot_tokens']:>8.1f} {r['cot_words']:>8.1f}")
+
+
+if __name__ == "__main__":
+    main()
