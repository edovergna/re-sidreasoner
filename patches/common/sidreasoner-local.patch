index 0000000..918e9f0
--- /dev/null
+++ b/utils/summarize_labeled_eval_table.py
@@ -0,0 +1,202 @@
+import argparse
+import json
+import math
+import os
+import re
+
+
+def _normalize_prediction(value):
+    return value.strip('"\n').strip()
+
+
+def _safe_cell(value):
+    return str(value).replace("|", r"\|")
+
+
+def _load_items(item_path):
+    if item_path.endswith(".txt"):
+        item_path = item_path[:-4]
+    with open(f"{item_path}.txt", "r") as f:
+        return {line.split("\t")[0].strip() for line in f.readlines()}
+
+
+def _metrics(result_path, item_path, topk_list):
+    valid_items = _load_items(item_path)
+    with open(result_path, "r") as f:
+        test_data = json.load(f)
+
+    if not test_data:
+        return {"n": 0, "invalid": 0}
+
+    predictions = [[_normalize_prediction(pred) for pred in sample["predict"]] for sample in test_data]
+    n_beam = len(predictions[0]) if predictions else 0
+    valid_topk = [k for k in topk_list if k <= n_beam]
+    hits = {k: 0.0 for k in valid_topk}
+    ndcgs = {k: 0.0 for k in valid_topk}
+    invalid = 0
+
+    for sample, preds in zip(test_data, predictions):
+        target = sample["output"][0] if isinstance(sample["output"], list) else sample["output"]
+        target = target.strip(' \n"')
+        rank = None
+        for idx, pred in enumerate(preds):
+            if pred not in valid_items:
+                invalid += 1
+            if pred == target:
+                rank = idx
+                break
+
+        for k in valid_topk:
+            if rank is not None and rank < k:
+                hits[k] += 1
+                ndcgs[k] += (1 / math.log(rank + 2)) / (1 / math.log(2))
+
+    total = len(test_data)
+    return {
+        "n": total,
+        "invalid": invalid,
+        **{f"HR@{k}": hits[k] / total for k in valid_topk},
+        **{f"NDCG@{k}": ndcgs[k] / total for k in valid_topk},
+    }
+
+
+def _latest_metric(log_history, metric_name, step=None):
+    latest_value = None
+    latest_epoch = None
+    latest_step = None
+    for record in log_history:
+        if metric_name not in record:
+            continue
+        record_step = record.get("step")
+        if step is not None and record_step is not None and record_step > step:
+            continue
+        latest_value = record.get(metric_name)
+        latest_epoch = record.get("epoch")
+        latest_step = record_step
+    return latest_value, latest_epoch, latest_step
+
+
+def _load_training_state(checkpoint_path):
+    if not checkpoint_path:
+        return {}
+    state_path = os.path.join(checkpoint_path, "trainer_state.json")
+    if not os.path.exists(state_path):
+        return {}
+    with open(state_path, "r") as f:
+        state = json.load(f)
+
+    step = state.get("global_step")
+    log_history = state.get("log_history", [])
+    eval_loss, eval_epoch, eval_step = _latest_metric(log_history, "eval_loss", step=step)
+    title2sid_loss, _, _ = _latest_metric(log_history, "eval_title2sid_loss", step=step)
+    sid2title_loss, _, _ = _latest_metric(log_history, "eval_sid2title_loss", step=step)
+    return {
+        "step": eval_step if eval_step is not None else step,
+        "epoch": eval_epoch if eval_epoch is not None else state.get("epoch"),
+        "eval_loss": eval_loss,
+        "eval_title2sid_loss": title2sid_loss,
+        "eval_sid2title_loss": sid2title_loss,
+        "best_metric": state.get("best_metric"),
+    }
+
+
+def _fmt_metric(value):
+    if value is None:
+        return "n/a"
+    if isinstance(value, float):
+        return f"{value:.6f}"
+    return str(value)
+
+
+def main(manifest_path, output_path=None, title="Evaluation Summary", topk="1,3,5,10"):
+    topk_list = [int(k) for k in re.split(r"[, ]+", topk) if k]
+    rows = []
+    with open(manifest_path, "r") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            parts = line.split("\t")
+            if len(parts) == 4:
+                label, category, result_path, info_file = parts
+                checkpoint_path = ""
+            elif len(parts) >= 5:
+                label, category, result_path, info_file, checkpoint_path = parts[:5]
+            else:
+                raise ValueError(f"Expected 4 or 5 tab-separated columns, got {len(parts)} in: {line}")
+            rows.append((label, category, result_path, info_file, checkpoint_path))
+
+    lines = [f"# {title}", ""]
+    include_training_state = any(checkpoint_path for *_, checkpoint_path in rows)
+    header = [
+        "Checkpoint",
+        "Category",
+        "HR@1",
+        "HR@3",
+        "HR@5",
+        "HR@10",
+        "NDCG@1",
+        "NDCG@3",
+        "NDCG@5",
+        "NDCG@10",
+        "Invalid",
+        "N",
+    ]
+    align = ["---", "---"] + ["---:"] * 10
+    if include_training_state:
+        header.extend(["Train step", "Train epoch", "Eval loss", "Title2SID loss", "SID2Title loss", "Best eval loss"])
+        align.extend(["---:", "---:", "---:", "---:", "---:", "---:"])
+    lines.append("| " + " | ".join(header) + " |")
+    lines.append("| " + " | ".join(align) + " |")
+
+    for label, category, result_path, info_file, checkpoint_path in rows:
+        metrics = _metrics(result_path, info_file, topk_list)
+        row = [
+            _safe_cell(label),
+            _safe_cell(category),
+            f"{metrics.get('HR@1', 0.0):.6f}",
+            f"{metrics.get('HR@3', 0.0):.6f}",
+            f"{metrics.get('HR@5', 0.0):.6f}",
+            f"{metrics.get('HR@10', 0.0):.6f}",
+            f"{metrics.get('NDCG@1', 0.0):.6f}",
+            f"{metrics.get('NDCG@3', 0.0):.6f}",
+            f"{metrics.get('NDCG@5', 0.0):.6f}",
+            f"{metrics.get('NDCG@10', 0.0):.6f}",
+            str(metrics.get("invalid", 0)),
+            str(metrics.get("n", 0)),
+        ]
+        if include_training_state:
+            training_state = _load_training_state(checkpoint_path)
+            row.extend(
+                [
+                    _fmt_metric(training_state.get("step")),
+                    _fmt_metric(training_state.get("epoch")),
+                    _fmt_metric(training_state.get("eval_loss")),
+                    _fmt_metric(training_state.get("eval_title2sid_loss")),
+                    _fmt_metric(training_state.get("eval_sid2title_loss")),
+                    _fmt_metric(training_state.get("best_metric")),
+                ]
+            )
+        lines.append("| " + " | ".join(row) + " |")
+
+    summary = "\n".join(lines)
+    print(summary)
+    if output_path:
+        with open(output_path, "w") as f:
+            f.write(summary)
+            f.write("\n")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--manifest_path", required=True)
+    parser.add_argument("--output_path", default=None)
+    parser.add_argument("--title", default="Evaluation Summary")
+    parser.add_argument("--topk", default="1,3,5,10")
+    args = parser.parse_args()
+    main(
+        manifest_path=args.manifest_path,
+        output_path=args.output_path,
+        title=args.title,
+        topk=args.topk,
+    )
