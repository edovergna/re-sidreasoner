+echo "All checkpoints processed!"
+echo "Now run:  ${PYTHON_CMD} ./utils/collect_eval_metrics.py --results_dir ./results --category ${CATEGORY} --info_file ${INFO_FILE} --tokenizer ${STAGE2_MODEL} --out ./results/figure5_0p6B.csv"
