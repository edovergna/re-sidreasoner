+TRAIN_FILE="${TRAIN_FILE:-./data/Amazon/train/Video_Games_5_2016-10-2018-11.csv}"
+EVAL_FILE="${EVAL_FILE:-./data/Amazon/valid/Video_Games_5_2016-10-2018-11.csv}"
+TEST_FILE="${TEST_FILE:-./data/Amazon/test/Video_Games_5_2016-10-2018-11.csv}"
+INFO_FILE="${INFO_FILE:-./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt}"
+BASE_MODEL="${BASE_MODEL:-./output_dir/Video_Games_stage1_sft_Qwen3-1.7B_S1/final_checkpoint}"
