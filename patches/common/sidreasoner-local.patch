+++ b/utils/plot_size_comparison.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python
+"""Size-comparison plots over GRPO steps: 0.6B vs 4B on the SAME axes.
+
+Unlike plot_figure5.py (one dual-axis figure per model size), this produces
+TWO single-metric figures, each overlaying both model sizes:
+  1. Recall@10 vs RL step      (--out_recall)
+  2. avg CoT length vs RL step  (--out_cot)
+Line colour = model size: 0.6B = orange, 4B = blue.
+
+Recall comes from the per-step eval CSVs (--csv_06b / --csv_4b, column = --metric).
+CoT length comes from the dense per-step training logs (--cot_06b / --cot_4b,
+column = --cot_col), subsampled every --cot_every steps to match the paper's
+point spacing.
+
+Usage:
+  python scripts/plot_size_comparison.py \
+      --csv_06b results/figure5_0p6B.csv --csv_4b results/figure5_4B.csv \
+      --cot_06b results/train_lengths_0p6B.csv --cot_4b results/train_lengths_4B.csv \
+      --cot_every 50 --metric HR@10 \
+      --out_recall results/recall_0p6B_vs_4B.png \
+      --out_cot   results/cot_0p6B_vs_4B.png
+"""
+import csv
+import argparse
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+
+
+C_06B, C_4B = "#ff7f0e", "#1f77b4"   # orange = 0.6B, blue = 4B
+
+
+def load_xy(path, xcol, ycol):
+    """Return (xs, ys) sorted by x for rows where ycol parses as float."""
+    xs, ys = [], []
+    with open(path, newline="") as f:
+        for row in csv.DictReader(f):
+            try:
+                x = float(row[xcol])
+                y = float(row[ycol])
+            except (TypeError, ValueError, KeyError):
+                continue
+            xs.append(x)
+            ys.append(y)
+    order = sorted(range(len(xs)), key=lambda i: xs[i])
+    return [xs[i] for i in order], [ys[i] for i in order]
+
+
+def subsample(xs, ys, every):
+    """Keep the first point plus every `every`-th step (x % every == 0)."""
+    ox, oy = [], []
+    for i, (x, y) in enumerate(zip(xs, ys)):
+        if i == 0 or x % every == 0:
+            ox.append(x)
+            oy.append(y)
+    return ox, oy
+
+
+def plot_metric(series, ylabel, title, out, marker):
+    """series = list of (label, color, xs, ys)."""
+    fig, ax = plt.subplots(figsize=(7, 4.5))
+    for label, color, xs, ys in series:
+        ax.plot(xs, ys, color=color, marker=marker, linewidth=2, label=label)
+    ax.set_xlabel("RL training step")
+    ax.set_ylabel(ylabel)
+    ax.grid(True, alpha=0.3)
+    ax.legend(loc="best", fontsize=10, framealpha=0.9)
+    ax.set_title(title)
+    fig.tight_layout()
+    fig.savefig(out, dpi=200)
+    print(f"Saved {out}")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--csv_06b", required=True, help="0.6B per-step eval CSV (perf)")
+    ap.add_argument("--csv_4b", required=True, help="4B per-step eval CSV (perf)")
+    ap.add_argument("--cot_06b", default=None, help="0.6B dense training-length CSV")
+    ap.add_argument("--cot_4b", default=None, help="4B dense training-length CSV")
+    ap.add_argument("--cot_col", default="response_length_mean",
+                    help="CoT column name inside the --cot_* CSVs")
+    ap.add_argument("--csv_cot_col", default="cot_tokens",
+                    help="fallback CoT column in --csv_* when --cot_* not given")
+    ap.add_argument("--cot_every", type=int, default=50)
+    ap.add_argument("--metric", default="HR@10")
+    ap.add_argument("--out_recall", default="results/recall_0p6B_vs_4B.png")
+    ap.add_argument("--out_cot", default="results/cot_0p6B_vs_4B.png")
+    args = ap.parse_args()
+
+    # ---- Recall figure ----
+    s06, p06 = load_xy(args.csv_06b, "step", args.metric)
+    s4, p4 = load_xy(args.csv_4b, "step", args.metric)
+    plot_metric(
+        [("0.6B", C_06B, s06, p06), ("4B", C_4B, s4, p4)],
+        ylabel=args.metric,
+        title=f"GRPO: {args.metric} vs RL step (0.6B vs 4B)",
+        out=args.out_recall, marker="o",
+    )
+
+    # ---- CoT-length figure ----
+    def cot_series(csv_path, cot_path):
+        if cot_path:
+            xs, ys = load_xy(cot_path, "step", args.cot_col)
+            return subsample(xs, ys, args.cot_every)
+        return load_xy(csv_path, "step", args.csv_cot_col)
+
+    c06x, c06y = cot_series(args.csv_06b, args.cot_06b)
+    c4x, c4y = cot_series(args.csv_4b, args.cot_4b)
+    plot_metric(
+        [("0.6B", C_06B, c06x, c06y), ("4B", C_4B, c4x, c4y)],
+        ylabel="avg reasoning length (tokens)",
+        title="GRPO: CoT length vs RL step (0.6B vs 4B)",
+        out=args.out_cot, marker="s",
+    )
+
+
+if __name__ == "__main__":
+    main()
