+
+if [[ -d "${STAGE2_MODEL}" ]]; then
+    exp_list+=("${STAGE2_MODEL}")
+else
+    echo "Warning: Stage 2 checkpoint not found at ${STAGE2_MODEL} (skipping step 0)"
+fi
+
+if [[ -d "${STAGE3_EXPERIMENT_ROOT}" ]]; then
