+def _gini(counts, catalog_size):
+    """Exposure Gini over the full catalog, including unexposed items.
+
+    Zero exposures precede the sorted observed counts. Offset their ranks
+    rather than allocating a dense catalog-sized array. An all-zero exposure
+    vector returns 0.0, matching the SASRec evaluator's convention.
+    """
+    if catalog_size < len(counts) or catalog_size < 0:
+        raise ValueError("Catalog size cannot be smaller than the exposure counter")
+    if not counts:
+        return 0.0
+    values = np.array(sorted(counts.values()), dtype=np.float64)
+    if not np.all(np.isfinite(values)) or np.any(values < 0):
+        raise ValueError("Exposure counts must be finite and nonnegative")
+    total = values.sum()
+    if total == 0:
+        return 0.0
+    n = catalog_size
+    index = np.arange(n - len(values) + 1, n + 1)
+    return float((2 * np.sum(index * values) / (n * total)) - ((n + 1) / n))
+
