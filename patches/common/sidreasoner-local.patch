+#!/usr/bin/env python
+"""Stage-comparison line plot: x = pipeline stage (SFT -> RA -> GRPO), one line per
+model size, y = Recall@10 (or NDCG@10). Reads a CSV with columns:
+    model, stage, hr10[, ndcg10]
+so you can append more rows (e.g. a 1.7B line) without touching code.
+
+RA = reasoning activation (the checkpoint that fed GRPO). GRPO = final step.
+
+Usage:
+  python scripts/plot_stage_comparison.py --csv results/stage_comparison.csv \
+      --out results/stage_comparison.png
+  # NDCG instead:
+  python scripts/plot_stage_comparison.py --csv results/stage_comparison.csv \
+      --metric ndcg10 --ylabel "NDCG@10" --out results/stage_comparison_ndcg.png
+"""
+import csv
+import argparse
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--csv", required=True)
+    ap.add_argument("--metric", default="hr10")
+    ap.add_argument("--ylabel", default="Recall@10")
+    ap.add_argument("--stages", default="SFT,RA,GRPO",
+                    help="stage order on the x-axis (comma-separated)")
+    ap.add_argument("--annotate", action="store_true",
+                    help="print the value next to each point")
+    ap.add_argument("--out", default="results/stage_comparison.png")
+    args = ap.parse_args()
+
+    stages = args.stages.split(",")
+    xpos = {s: i for i, s in enumerate(stages)}
+
+    # model -> {stage: value}; preserve first-seen model order for a stable legend
+    data, order = {}, []
+    with open(args.csv, newline="") as f:
+        for row in csv.DictReader(f):
+            m = row["model"]
+            if m not in data:
+                data[m] = {}
+                order.append(m)
+            data[m][row["stage"]] = float(row[args.metric])
+
+    fig, ax = plt.subplots(figsize=(6, 4.5))
+    for model in order:
+        d = data[model]
+        pts = [(xpos[s], d[s]) for s in stages if s in d]
+        xs, ys = zip(*pts)
+        ax.plot(xs, ys, marker="o", linewidth=2, markersize=8, label=model)
+        if args.annotate:
+            for x, y in pts:
+                ax.annotate(f"{y:.4f}", (x, y), textcoords="offset points",
+                            xytext=(6, 4), fontsize=8)
+
+    ax.set_xticks(range(len(stages)))
+    ax.set_xticklabels(stages)
+    ax.set_xlabel("pipeline stage")
+    ax.set_ylabel(args.ylabel)
+    ax.set_title(f"{args.ylabel} across stages, by model size")
+    ax.grid(True, alpha=0.3)
+    ax.legend(title="model size", loc="best")
+    fig.tight_layout()
+    fig.savefig(args.out, dpi=200)
+    print(f"Saved {args.out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/push_to_hf.py b/utils/push_to_hf.py
new file mode 100644
index 0000000..6130991
--- /dev/null
+++ b/utils/push_to_hf.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python
+"""Push SIDReasoner extension checkpoints to a Hugging Face model repo.
+
+Each entry uploads a merged HF model dir into its own subfolder of one repo.
+Set CHECKPOINT_ROOT, GRPO_CHECKPOINT_ROOT, and HF_REPO_ID, then:
+
+    export HF_TOKEN=hf_xxx                    # write token from huggingface.co/settings/tokens
+    python utils/push_to_hf.py --dry-run    # validate paths first (expect all OK)
+    python utils/push_to_hf.py              # upload
+
+The upload is large (~34 GB for all 8); run it inside tmux/screen so it
+survives a disconnect. Re-running is safe: upload_folder skips files that are
+already present, so an interrupted transfer just resumes.
+"""
+import os
+import sys
+import argparse
+from huggingface_hub import HfApi, login
+
+REPO_ID = os.environ.get("HF_REPO_ID")
+
+PROJ = os.environ.get("CHECKPOINT_ROOT", "./checkpoints")
+GRPO_ROOT = os.environ.get("GRPO_CHECKPOINT_ROOT", "./checkpoints")
+
+# repo subfolder -> absolute path of the MERGED HF checkpoint dir
+# (must contain config.json + *.safetensors; NOT a raw verl FSDP shard dir)
+CHECKPOINTS = {
+    "0.6B/SFT":  f"{PROJ}/0.6B/Video_Games_stage1_sft_S3/final_checkpoint",
+    "0.6B/RA":   f"{PROJ}/0.6B/Video_Games_stage2_act_5ep_S3/final_checkpoint",
+    "0.6B/GRPO": f"{PROJ}/0.6B/Video_Games_stage3_rl_S3/step_500/actor_merged",
+    "4B/SFT":    f"{PROJ}/4B/Video_Games_stage1_sft_S3/final_checkpoint",
+    "4B/RA":     f"{PROJ}/4B/Video_Games_stage2_act_1ep_S3/final_checkpoint",
+    "4B/GRPO":   f"{GRPO_ROOT}/RecRL_Reasoning/Video_Games_stage3_rl_Qwen3-4B_S3/global_step_500/actor_merged",
+    # optional 1.7B S1 from-scratch reproduction (Games only):
+    "1.7B-S1/SFT": f"{PROJ}/1.7B/Video_Games_stage1_sft_S1/final_checkpoint",
+    "1.7B-S1/RA":  f"{PROJ}/1.7B/Video_Games_stage2_act_5ep_S1/final_checkpoint",
+}
+
+# never ship optimizer/training cruft even if a dir happens to contain it
+IGNORE = ["optimizer*.pt", "scheduler.pt", "rng_state*.pth", "trainer_state.json",
+          "*.out", "global_step*/**"]
+
+
+def validate():
+    bad = []
+    for sub, path in CHECKPOINTS.items():
+        ok = (os.path.isdir(path)
+              and os.path.isfile(os.path.join(path, "config.json"))
+              and any(f.endswith(".safetensors") for f in os.listdir(path)))
+        print(f"[{'OK ' if ok else 'BAD'}] {sub:12s} -> {path}")
+        if not ok:
+            bad.append(sub)
+    return bad
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dry-run", action="store_true", help="validate paths, upload nothing")
+    args = ap.parse_args()
+
+    bad = validate()
+    if bad:
+        print(f"\nRefusing to start: {len(bad)} invalid path(s): {bad}", file=sys.stderr)
+        sys.exit(1)
+    if args.dry_run:
+        print("\nDry run OK -- all paths valid.")
+        return
+
+    if not REPO_ID:
+        ap.error("Set HF_REPO_ID to the destination model repository before uploading.")
+    login(token=os.environ.get("HF_TOKEN"))   # falls back to interactive if unset
+    api = HfApi()
+    api.create_repo(REPO_ID, repo_type="model", exist_ok=True)
+
+    for sub, path in CHECKPOINTS.items():
+        print(f"\nUploading {sub} ...")
+        api.upload_folder(folder_path=path, repo_id=REPO_ID, repo_type="model",
+                          path_in_repo=sub, ignore_patterns=IGNORE,
+                          commit_message=f"Add {sub} checkpoint")
+    print(f"\nDone -> https://huggingface.co/{REPO_ID}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/summarize_item_side_diversity.py b/utils/summarize_item_side_diversity.py
new file mode 100644
index 0000000..6f12618
--- /dev/null
+++ b/utils/summarize_item_side_diversity.py
@@ -0,0 +1,290 @@
+import argparse
+import json
+import math
+import re
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+
+
+def _normalize_prediction(value):
+    return value.strip('"\n').strip()
+
+
+def _safe_cell(value):
+    return str(value).replace("|", r"\|")
+
+
+def _load_items(info_file):
+    with open(info_file, "r") as f:
+        return [line.split("\t")[0].strip() for line in f.readlines()]
+
+
+def _entropy(counts):
+    total = sum(counts.values())
+    if total == 0:
+        return 0.0
+    probs = np.array([count / total for count in counts.values()], dtype=np.float64)
+    return float(-(probs * np.log(probs + 1e-12)).sum())
+
+
+def _gini(counts, catalog_size):
+    """Exposure Gini over the full catalog, including unexposed items.
+
+    Zero exposures precede the sorted observed counts. Offset their ranks
+    rather than allocating a dense catalog-sized array. An all-zero exposure
+    vector returns 0.0, matching the SASRec evaluator's convention.
+    """
+    if catalog_size < len(counts) or catalog_size < 0:
+        raise ValueError("Catalog size cannot be smaller than the exposure counter")
+    if not counts:
+        return 0.0
+    values = np.array(sorted(counts.values()), dtype=np.float64)
+    if not np.all(np.isfinite(values)) or np.any(values < 0):
+        raise ValueError("Exposure counts must be finite and nonnegative")
+    total = values.sum()
+    if total == 0:
+        return 0.0
+    n = catalog_size
+    index = np.arange(n - len(values) + 1, n + 1)
+    return float((2 * np.sum(index * values) / (n * total)) - ((n + 1) / n))
+
+
+def _metrics(result_path, info_file, k=10):
+    items = _load_items(info_file)
+    valid_items = set(items)
+    catalog_size = max(len(items), 1)
+
+    with open(result_path, "r") as f:
+        test_data = json.load(f)
+
+    if not test_data:
+        return {"N": 0, "Invalid": 0}
+
+    hits = 0
+    ndcg = 0.0
+    invalid = 0
+    all_recommended = []
+
+    for sample in test_data:
+        predictions = [_normalize_prediction(pred) for pred in sample["predict"]]
+        preds_at_k = predictions[:k]
+        target = sample["output"][0] if isinstance(sample["output"], list) else sample["output"]
+        target = target.strip(' \n"')
+
+        rank = None
+        for idx, pred in enumerate(predictions):
+            if pred not in valid_items:
+                invalid += 1
+            if pred == target:
+                rank = idx
+                break
+
+        if rank is not None and rank < k:
+            hits += 1
+            ndcg += (1 / math.log(rank + 2)) / (1 / math.log(2))
+
+        all_recommended.extend(pred for pred in preds_at_k if pred in valid_items)
+
+    counts = Counter(all_recommended)
+    n = len(test_data)
+    return {
+        "N": n,
+        "Invalid": invalid,
+        "HR@10": hits / n,
+        "NDCG@10": ndcg / n,
+        "Coverage@10": len(counts) / catalog_size,
+        "Entropy@10": _entropy(counts),
+        "Gini@10": _gini(counts, catalog_size),
+    }
+
+
+def _fmt(value):
+    if isinstance(value, float):
+        return f"{value:.6f}"
+    return str(value)
+
+
+def _fmt_mean_std(values):
+    arr = np.array(values, dtype=np.float64)
+    if len(arr) == 1:
+        return f"{arr.mean():.6f}"
+    return f"{arr.mean():.6f} +/- {arr.std(ddof=0):.6f}"
+
+
+def _stage_sort(stage):
+    return {"sft": 0, "ra": 1, "rl": 2}.get(stage.lower(), 99)
+
+
+def _decoder_sort(decoder):
+    return {"beam10": 0, "sample_t12_p095": 1, "sample_t10_k50": 2}.get(decoder, 99)
+
+
+def _read_manifest(path):
+    rows = []
+    with open(path, "r") as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            parts = line.split("\t")
+            if len(parts) < 6:
+                raise ValueError(f"Expected at least 6 columns, got {len(parts)}: {line}")
+            dataset, stage, decoder, seed, result_path, info_file = parts[:6]
+            checkpoint_path = parts[6] if len(parts) > 6 else ""
+            rows.append(
+                {
+                    "dataset": dataset,
+                    "stage": stage,
+                    "decoder": decoder,
+                    "seed": int(seed),
+                    "result_path": result_path,
+                    "info_file": info_file,
+                    "checkpoint_path": checkpoint_path,
+                }
+            )
+    return rows
+
+
+def _interpret(aggregates):
+    lines = ["## Interpretation", ""]
+    by_dataset_decoder = defaultdict(dict)
+    for key, metrics in aggregates.items():
+        dataset, stage, decoder = key
+        by_dataset_decoder[(dataset, decoder)][stage] = metrics
+
+    wrote_any = False
+    for (dataset, decoder), stages in sorted(by_dataset_decoder.items(), key=lambda item: (item[0][0], _decoder_sort(item[0][1]))):
+        if "ra" not in stages or "sft" not in stages:
+            continue
+        ra = stages["ra"]
+        sft = stages["sft"]
+        hr_delta = np.mean(ra["HR@10"]) - np.mean(sft["HR@10"])
+        cov_delta = np.mean(ra["Coverage@10"]) - np.mean(sft["Coverage@10"])
+        gini_delta = np.mean(ra["Gini@10"]) - np.mean(sft["Gini@10"])
+        lines.append(
+            f"- {dataset}, `{decoder}`: RA minus SFT changes HR@10 by `{hr_delta:+.6f}`, "
+            f"Coverage@10 by `{cov_delta:+.6f}`, and Gini@10 by `{gini_delta:+.6f}`."
+        )
+        wrote_any = True
+
+    for dataset in sorted({key[0] for key in aggregates}):
+        stage_decoder = {
+            (stage, decoder): metrics
+            for (ds, stage, decoder), metrics in aggregates.items()
+            if ds == dataset
+        }
+        for stage in ("sft", "ra", "rl"):
+            if (stage, "beam10") not in stage_decoder:
+                continue
+            beam = stage_decoder[(stage, "beam10")]
+            for decoder in ("sample_t12_p095", "sample_t10_k50"):
+                if (stage, decoder) not in stage_decoder:
+                    continue
+                sample = stage_decoder[(stage, decoder)]
+                hr_delta = np.mean(sample["HR@10"]) - np.mean(beam["HR@10"])
+                cov_delta = np.mean(sample["Coverage@10"]) - np.mean(beam["Coverage@10"])
+                entropy_delta = np.mean(sample["Entropy@10"]) - np.mean(beam["Entropy@10"])
+                lines.append(
+                    f"- {dataset}, {stage.upper()}, `{decoder}` minus `beam10`: "
+                    f"HR@10 `{hr_delta:+.6f}`, Coverage@10 `{cov_delta:+.6f}`, "
+                    f"Entropy@10 `{entropy_delta:+.6f}`."
+                )
+                wrote_any = True
+
+    if not wrote_any:
+        lines.append("- Not enough completed rows yet for comparative interpretation.")
+    lines.append("")
+    lines.append(
+        "Lower Gini@10 indicates less concentrated exposure across the full catalog; higher Coverage@10 and Entropy@10 indicate broader item-side exposure."
+    )
+    return lines
+
+
+def main(manifest_path, output_path, title="Item-side diversity decoding study"):
+    rows = _read_manifest(manifest_path)
+    detailed = []
+    for row in rows:
+        result_path = Path(row["result_path"])
+        if not result_path.exists():
+            continue
+        metrics = _metrics(str(result_path), row["info_file"], k=10)
+        detailed.append({**row, **metrics})
+
+    detailed.sort(key=lambda r: (r["dataset"], _stage_sort(r["stage"]), _decoder_sort(r["decoder"]), r["seed"]))
+    grouped = defaultdict(lambda: defaultdict(list))
+    for row in detailed:
+        key = (row["dataset"], row["stage"], row["decoder"])
+        for metric in ("HR@10", "NDCG@10", "Coverage@10", "Entropy@10", "Gini@10"):
+            grouped[key][metric].append(row[metric])
+
+    lines = [f"# {title}", ""]
+    lines.append("All values are computed at `K=10`. Aggregate rows report `mean +/- std` over completed seeds.")
+    lines.append("")
+    lines.append("## Aggregate Results")
+    lines.append("")
+    lines.append("| Dataset | Model stage | Decoding | Seeds | HR@10 | NDCG@10 | Coverage@10 | Entropy@10 | Gini@10 |")
+    lines.append("|---|---|---|---:|---:|---:|---:|---:|---:|")
+    for (dataset, stage, decoder), metrics in sorted(grouped.items(), key=lambda item: (item[0][0], _stage_sort(item[0][1]), _decoder_sort(item[0][2]))):
+        seed_count = len(metrics["HR@10"])
+        lines.append(
+            "| "
+            + " | ".join(
+                [
+                    _safe_cell(dataset),
+                    _safe_cell(stage.upper()),
+                    f"`{_safe_cell(decoder)}`",
+                    str(seed_count),
+                    _fmt_mean_std(metrics["HR@10"]),
+                    _fmt_mean_std(metrics["NDCG@10"]),
+                    _fmt_mean_std(metrics["Coverage@10"]),
+                    _fmt_mean_std(metrics["Entropy@10"]),
+                    _fmt_mean_std(metrics["Gini@10"]),
+                ]
+            )
+            + " |"
+        )
+
+    lines.append("")
+    lines.append("## Per-seed Results")
+    lines.append("")
+    lines.append("| Dataset | Model stage | Decoding | Seed | HR@10 | NDCG@10 | Coverage@10 | Entropy@10 | Gini@10 | Invalid | N |")
+    lines.append("|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|")
+    for row in detailed:
+        lines.append(
+            "| "
+            + " | ".join(
+                [
+                    _safe_cell(row["dataset"]),
+                    _safe_cell(row["stage"].upper()),
+                    f"`{_safe_cell(row['decoder'])}`",
+                    str(row["seed"]),
+                    _fmt(row["HR@10"]),
+                    _fmt(row["NDCG@10"]),
+                    _fmt(row["Coverage@10"]),
+                    _fmt(row["Entropy@10"]),
+                    _fmt(row["Gini@10"]),
+                    str(row["Invalid"]),
+                    str(row["N"]),
+                ]
+            )
+            + " |"
+        )
+
+    lines.append("")
+    lines.extend(_interpret(grouped))
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    output_path.write_text("\n".join(lines) + "\n")
+    print("\n".join(lines))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--manifest-path", required=True)
+    parser.add_argument("--output-path", required=True)
+    parser.add_argument("--title", default="Item-side diversity decoding study")
+    args = parser.parse_args()
+    main(args.manifest_path, args.output_path, args.title)
