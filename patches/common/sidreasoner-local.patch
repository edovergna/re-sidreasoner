+import argparse
+from pathlib import Path
+
+from huggingface_hub import snapshot_download
+
+
+DEFAULT_REPO_ID = "Sober-Clever/SIDReasoner-Models"
+DEFAULT_ALLOW_PATTERNS = [
+    "Office_Products/Qwen3-1.7B_base_e2e-General_stepRule-smalllR_Office_Products/actor_merged/*",
+    (
+        "Industrial_and_Scientific/"
+        "Qwen3-1.7B_base_e2e-gptgen-general-ep1_stepRule-smalllR_Industrial_and_Scientific/actor_merged/*"
+    ),
+    "Video_Games/Qwen3-1.7B_base_e2e-RA-GeneralReason_stepRule-smalllR_Games/actor_merged/*",
+]
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Download SIDReasoner pretrained checkpoints from Hugging Face.")
+    parser.add_argument("--repo-id", default=DEFAULT_REPO_ID)
+    parser.add_argument("--revision", default="main")
+    parser.add_argument("--local-dir", default="pretrained")
+    parser.add_argument(
+        "--allow-pattern",
+        action="append",
+        dest="allow_patterns",
+        help="Optional Hugging Face allow pattern. Can be passed multiple times.",
+    )
+    args = parser.parse_args()
+
+    local_dir = Path(args.local_dir)
+    local_dir.mkdir(parents=True, exist_ok=True)
+
+    allow_patterns = args.allow_patterns or DEFAULT_ALLOW_PATTERNS
+    print(f"Downloading {args.repo_id}@{args.revision} to {local_dir}")
+    print("Allow patterns:")
+    for pattern in allow_patterns:
+        print(f"  - {pattern}")
+
+    snapshot_download(
+        repo_id=args.repo_id,
+        revision=args.revision,
+        repo_type="model",
+        local_dir=str(local_dir),
+        allow_patterns=allow_patterns,
+        resume_download=True,
+    )
+
+    if args.allow_patterns:
+        print(f"Download complete: {local_dir}")
+    else:
+        print("Pretrained checkpoints are available at:")
+        for pattern in DEFAULT_ALLOW_PATTERNS:
+            ckpt_dir = local_dir / pattern.removesuffix("/*")
+            print(f"  - {ckpt_dir}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/evaluate_prompt_ablation.py b/utils/evaluate_prompt_ablation.py
new file mode 100644
index 0000000..3df0b05
--- /dev/null
+++ b/utils/evaluate_prompt_ablation.py
@@ -0,0 +1,446 @@
+import argparse
+import gc
+import json
+import multiprocessing as mp
+import os
+import random
+from dataclasses import dataclass
+from typing import Callable
+
+import numpy as np
+import pandas as pd
+import torch
+from tqdm import tqdm
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+
+def current_device():
+    return "cuda" if torch.cuda.is_available() else "cpu"
+
+
+@dataclass(frozen=True)
+class AblationConfig:
+    prompt_builder: Callable[[str], str]
+    system_prompt: str
+    generate_reasoning: bool
+    reasoning_tokens: int | None
+    prefix_prompt: str
+    prefix_index: int
+
+
+DIRECT_SYSTEM = """Below is an instruction that describes a task, paired with an input that provides further context. Write a response that appropriately completes the request.
+Can you predict the next possible item that the user may expect?
+"""
+
+REASONING_SYSTEM = """Below is an instruction that describes a task, paired with an input that provides further context. Write a response that appropriately completes the request.
+Can you recommend the next item for the user based on their interaction history?
+"""
+
+
+def _direct_prompt(history):
+    return f"Can you predict the next possible item the user may expect, given the following chronological interaction history: {history}"
+
+
+def _thinking_prompt(history):
+    return (
+        f"The user has sequentially interacted with items {history}. Can you recommend the next item for him? "
+        "Let's think step by step before making recommendation. Directly output the item SID after thinking."
+    )
+
+
+def _no_step_prompt(history):
+    return (
+        f"The user has sequentially interacted with items {history}. Can you recommend the next item for him? "
+        "Directly output the item SID."
+    )
+
+
+def _preference_summary_prompt(history):
+    return (
+        f"The user has sequentially interacted with items {history}. Briefly identify the user's recent preference "
+        "pattern from the item SID history, then directly output the item SID."
+    )
+
+
+ABLATIONS = {
+    "empty_think": AblationConfig(
+        _direct_prompt, DIRECT_SYSTEM, False, None, "\n</think>\n\n", 3
+    ),
+    "generated_think": AblationConfig(
+        _thinking_prompt, REASONING_SYSTEM, True, None, "</think>\n\n", 2
+    ),
+    "generated_think_64": AblationConfig(
+        _thinking_prompt, REASONING_SYSTEM, True, 64, "</think>\n\n", 2
+    ),
+    "generated_think_128": AblationConfig(
+        _thinking_prompt, REASONING_SYSTEM, True, 128, "</think>\n\n", 2
+    ),
+    "no_step": AblationConfig(
+        _no_step_prompt, REASONING_SYSTEM, False, None, "\n</think>\n\n", 3
+    ),
+    "preference_summary": AblationConfig(
+        _preference_summary_prompt, REASONING_SYSTEM, True, 128, "</think>\n\n", 2
+    ),
+}
+
+
+def get_hash(values):
+    return "-".join(str(value) for value in values)
+
+
+def set_seed(seed, seed_cuda=True):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if seed_cuda and torch.cuda.is_available():
+        torch.cuda.manual_seed(seed)
+        torch.cuda.manual_seed_all(seed)
+
+
+def _extract_input_ids(tokenized):
+    if hasattr(tokenized, "tolist"):
+        tokenized = tokenized.tolist()
+    if hasattr(tokenized, "input_ids"):
+        tokenized = tokenized.input_ids
+    if isinstance(tokenized, dict):
+        tokenized = tokenized["input_ids"]
+    if tokenized and isinstance(tokenized[0], list):
+        tokenized = tokenized[0]
+    return tokenized
+
+
+def _load_rows(test_data_path, ablation_config):
+    data = pd.read_csv(test_data_path)
+    rows = []
+    for _, row in data.iterrows():
+        history_item_sid = eval(row["history_item_sid"])
+        history = ", ".join(history_item_sid)
+        target_sid = str(row["item_sid"])
+        rows.append(
+            {
+                "history_str": history,
+                "input": ablation_config.prompt_builder(history),
+                "output": target_sid,
+                "dedup": bool(history_item_sid and target_sid == history_item_sid[-1]),
+            }
+        )
+    return rows
+
+
+def _tokenize_messages(tokenizer, system_prompt, user_prompt, max_len):
+    messages = [
+        {"role": "system", "content": system_prompt},
+        {"role": "user", "content": user_prompt},
+    ]
+    tokenized = tokenizer.apply_chat_template(
+        messages,
+        add_generation_prompt=True,
+        tokenize=True,
+        return_tensors=None,
+    )
+    input_ids = _extract_input_ids(tokenized)
+    return input_ids[-max_len:] if len(input_ids) > max_len else input_ids
+
+
+def _build_empty_think_inputs(tokenizer, rows, config, max_len):
+    suffix_ids = _extract_input_ids(tokenizer("<think>\n</think>\n\n", add_special_tokens=False))
+    encodings = []
+    prompt_texts = []
+    for row in rows:
+        input_ids = _tokenize_messages(tokenizer, config.system_prompt, row["input"], max_len)
+        input_ids = input_ids + suffix_ids
+        max_total = max_len + len(suffix_ids)
+        if len(input_ids) > max_total:
+            input_ids = input_ids[-max_total:]
+        encodings.append({"input_ids": input_ids, "attention_mask": [1] * len(input_ids)})
+        prompt_texts.append(tokenizer.decode(input_ids, skip_special_tokens=False))
+    return encodings, prompt_texts
+
+
+def _build_reasoning_prompts(tokenizer, rows, config, max_len):
+    encodings = []
+    prompts = []
+    for row in rows:
+        input_ids = _tokenize_messages(tokenizer, config.system_prompt, row["input"], max_len)
+        encodings.append({"input_ids": input_ids, "attention_mask": [1] * len(input_ids)})
+        prompts.append(tokenizer.decode(input_ids, skip_special_tokens=False))
+    return encodings, prompts
+
+
+def _extract_reasoning(generated_text):
+    generated_text = generated_text.strip()
+    if "</think>" in generated_text:
+        return generated_text.split("</think>", 1)[0].strip()
+    return generated_text
+
+
+def _close_reasoning_prompt(prompt, generated_text):
+    combined = prompt + generated_text
+    if "</think>" in combined:
+        return combined.split("</think>", 1)[0].strip() + "\n</think>\n\n"
+    return combined.strip() + "\n</think>\n\n"
+
+
+def patch_qwen_tokenizer_for_vllm():
+    try:
+        from transformers.models.qwen2.tokenization_qwen2 import Qwen2Tokenizer
+    except ImportError:
+        Qwen2Tokenizer = None
+
+    try:
+        from transformers.models.qwen2.tokenization_qwen2_fast import Qwen2TokenizerFast
+    except ImportError:
+        Qwen2TokenizerFast = None
+
+    for tokenizer_cls in (Qwen2Tokenizer, Qwen2TokenizerFast):
+        if tokenizer_cls is not None and not hasattr(tokenizer_cls, "all_special_tokens_extended"):
+            tokenizer_cls.all_special_tokens_extended = property(lambda self: self.all_special_tokens)
+
+
+def _generate_reasoning(base_model, prompts, max_tokens, temperature, top_p, top_k, seed, max_model_len):
+    os.environ.setdefault("VLLM_WORKER_MULTIPROC_METHOD", "spawn")
+    try:
+        mp.set_start_method("spawn", force=True)
+    except RuntimeError:
+        pass
+    patch_qwen_tokenizer_for_vllm()
+    from vllm import LLM, SamplingParams
+
+    sampling_params = SamplingParams(
+        max_tokens=max_tokens,
+        temperature=temperature,
+        top_p=top_p,
+        top_k=top_k if top_k > 0 else -1,
+        seed=seed if temperature > 0 else None,
+        skip_special_tokens=False,
+    )
+    llm = LLM(
+        model=base_model,
+        max_model_len=max_model_len,
+        max_num_seqs=32,
+        dtype="bfloat16",
+        gpu_memory_utilization=0.85,
+        tensor_parallel_size=1,
+    )
+    with torch.no_grad():
+        outputs = llm.generate(prompts, sampling_params)
+    generated = [output.outputs[0].text.strip() for output in outputs]
+    del llm
+    gc.collect()
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
+    return generated
+
+
+def _build_sid_constraint(tokenizer, info_file, base_model, prefix_prompt, prefix_index):
+    with open(info_file, "r") as f:
+        semantic_ids = [line.split("\t")[0].strip() for line in f.readlines()]
+
+    info_semantic = [f"{prefix_prompt}{semantic_id}\n" for semantic_id in semantic_ids]
+    if "llama" in base_model.lower():
+        prefix_ids = [tokenizer(text).input_ids[1:] for text in info_semantic]
+    else:
+        prefix_ids = [tokenizer(text).input_ids for text in info_semantic]
+
+    hash_dict = {}
+    for ids in prefix_ids:
+        ids.append(tokenizer.eos_token_id)
+        for i in range(prefix_index, len(ids)):
+            hash_number = get_hash(ids[:i]) if i == prefix_index else get_hash(ids[prefix_index:i])
+            hash_dict.setdefault(hash_number, set()).add(ids[i])
+    hash_dict = {key: list(value) for key, value in hash_dict.items()}
+
+    sep_ids = tokenizer(prefix_prompt, add_special_tokens=False)["input_ids"]
+    eos_id = tokenizer.eos_token_id
+
+    def find_last_sublist(values, sublist):
+        if not sublist:
+            return None
+        for start in range(len(values) - len(sublist), -1, -1):
+            if values[start : start + len(sublist)] == sublist:
+                return start
+        return None
+
+    def prefix_allowed_tokens_fn(_batch_id, input_ids):
+        input_ids = input_ids.tolist()
+        pos = find_last_sublist(input_ids, sep_ids)
+        if pos is None:
+            raise RuntimeError(f"Prefix prompt not found in input IDs: {tokenizer.decode(input_ids)}")
+        generated_after_sep = input_ids[pos + len(sep_ids) :]
+        hash_number = get_hash(sep_ids) if not generated_after_sep else get_hash(generated_after_sep)
+        return hash_dict.get(hash_number, [eos_id])
+
+    return prefix_allowed_tokens_fn
+
+
+def _decode_sid_batches(
+    model,
+    tokenizer,
+    encodings,
+    prefix_allowed_tokens_fn,
+    batch_size,
+    num_beams,
+    max_new_tokens,
+    length_penalty,
+    padding_side,
+):
+    outputs = []
+    batches = [encodings[i : i + batch_size] for i in range(0, len(encodings), batch_size)]
+
+    for batch in tqdm(batches, desc="Decoding constrained SIDs"):
+        max_len = max(len(item["input_ids"]) for item in batch)
+        padded_input_ids = []
+        attention_mask = []
+        for item in batch:
+            input_ids = item["input_ids"]
+            pad_len = max_len - len(input_ids)
+            if padding_side == "left":
+                padded_input_ids.append([tokenizer.pad_token_id] * pad_len + input_ids)
+                attention_mask.append([0] * pad_len + [1] * len(input_ids))
+            elif padding_side == "right":
+                padded_input_ids.append(input_ids + [tokenizer.pad_token_id] * pad_len)
+                attention_mask.append([1] * len(input_ids) + [0] * pad_len)
+            else:
+                raise ValueError("padding_side must be 'left' or 'right'")
+
+        with torch.no_grad():
+            generation_output = model.generate(
+                input_ids=torch.tensor(padded_input_ids).to(current_device()),
+                attention_mask=torch.tensor(attention_mask).to(current_device()),
+                max_new_tokens=max_new_tokens,
+                num_beams=num_beams,
+                num_return_sequences=num_beams,
+                output_scores=True,
+                return_dict_in_generate=True,
+                early_stopping=True,
+                length_penalty=length_penalty,
+                prefix_allowed_tokens_fn=prefix_allowed_tokens_fn,
+            )
+
+        completions = generation_output.sequences[:, max_len:]
+        if "llama" in model.name_or_path.lower():
+            decoded = tokenizer.batch_decode(
+                completions,
+                skip_special_tokens=True,
+                clean_up_tokenization_spaces=False,
+            )
+        else:
+            decoded = tokenizer.batch_decode(completions, skip_special_tokens=True)
+        decoded = [text.split("Response:\n")[-1].strip() for text in decoded]
+        outputs.extend([decoded[i * num_beams : (i + 1) * num_beams] for i in range(len(decoded) // num_beams)])
+
+    return outputs
+
+
+def main(args):
+    os.environ["FLASH_ATTENTION"] = "1"
+
+    config = ABLATIONS[args.ablation]
+    set_seed(args.seed, seed_cuda=not config.generate_reasoning)
+    reasoning_tokens = args.reasoning_max_new_tokens
+    if reasoning_tokens <= 0:
+        reasoning_tokens = config.reasoning_tokens or args.max_new_tokens
+
+    tokenizer = AutoTokenizer.from_pretrained(args.base_model)
+    tokenizer.pad_token = tokenizer.eos_token
+    tokenizer.pad_token_id = tokenizer.eos_token_id
+    tokenizer.padding_side = args.padding_side
+    tokenizer.truncation_side = "left"
+
+    rows = _load_rows(args.test_data_path, config)
+    if config.generate_reasoning:
+        _, prompts = _build_reasoning_prompts(tokenizer, rows, config, args.max_len)
+        generated = _generate_reasoning(
+            base_model=args.base_model,
+            prompts=prompts,
+            max_tokens=reasoning_tokens,
+            temperature=args.reasoning_temperature,
+            top_p=args.top_p,
+            top_k=args.top_k,
+            seed=args.seed,
+            max_model_len=args.vllm_max_model_len,
+        )
+        cots = [_extract_reasoning(text) for text in generated]
+        prompt_cot = [_close_reasoning_prompt(prompt, text) for prompt, text in zip(prompts, generated)]
+        encodings = []
+        for text in prompt_cot:
+            tokenized = tokenizer(text, return_tensors="pt", padding=True, truncation=True, max_length=args.max_len)
+            input_ids = tokenized["input_ids"][0].tolist()
+            encodings.append({"input_ids": input_ids, "attention_mask": [1] * len(input_ids)})
+    else:
+        encodings, prompt_cot = _build_empty_think_inputs(tokenizer, rows, config, args.max_len)
+        cots = [""] * len(rows)
+
+    prefix_allowed_tokens_fn = _build_sid_constraint(
+        tokenizer=tokenizer,
+        info_file=args.info_file,
+        base_model=args.base_model,
+        prefix_prompt=config.prefix_prompt,
+        prefix_index=config.prefix_index,
+    )
+
+    set_seed(args.seed, seed_cuda=True)
+    model = AutoModelForCausalLM.from_pretrained(args.base_model, torch_dtype=torch.bfloat16, device_map="auto")
+    model.eval()
+    model = model.to(current_device())
+    model.config.pad_token_id = model.config.eos_token_id = tokenizer.eos_token_id
+    model.config.bos_token_id = tokenizer.bos_token_id
+
+    predictions = _decode_sid_batches(
+        model=model,
+        tokenizer=tokenizer,
+        encodings=encodings,
+        prefix_allowed_tokens_fn=prefix_allowed_tokens_fn,
+        batch_size=args.batch_size,
+        num_beams=args.num_beams,
+        max_new_tokens=args.max_new_tokens,
+        length_penalty=args.length_penalty,
+        padding_side=args.padding_side,
+    )
+
+    for row, prediction, cot, prompt in zip(rows, predictions, cots, prompt_cot):
+        row["ablation"] = args.ablation
+        row["predict"] = prediction
+        if args.store_cot_text:
+            row["cot"] = cot
+        if args.store_prompt_text:
+            row["prompt_cot"] = prompt
+        row["decoding_config"] = {
+            "num_beams": args.num_beams,
+            "max_new_tokens": args.max_new_tokens,
+            "length_penalty": args.length_penalty,
+            "reasoning_max_new_tokens": reasoning_tokens if config.generate_reasoning else 0,
+            "reasoning_temperature": args.reasoning_temperature,
+            "top_p": args.top_p,
+            "top_k": args.top_k,
+            "seed": args.seed,
+        }
+        row.pop("dedup", None)
+
+    with open(args.result_json_data, "w") as f:
+        json.dump(rows, f, indent=4)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--base_model", required=True)
+    parser.add_argument("--info_file", required=True)
+    parser.add_argument("--category", default="")
+    parser.add_argument("--test_data_path", required=True)
+    parser.add_argument("--result_json_data", required=True)
+    parser.add_argument("--ablation", required=True, choices=sorted(ABLATIONS))
+    parser.add_argument("--batch_size", type=int, default=4)
+    parser.add_argument("--num_beams", type=int, default=10)
+    parser.add_argument("--max_new_tokens", type=int, default=256)
+    parser.add_argument("--reasoning_max_new_tokens", type=int, default=0)
+    parser.add_argument("--length_penalty", type=float, default=0.0)
+    parser.add_argument("--reasoning_temperature", type=float, default=0.0)
+    parser.add_argument("--top_p", type=float, default=1.0)
+    parser.add_argument("--top_k", type=int, default=0)
+    parser.add_argument("--padding_side", default="left")
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--max_len", type=int, default=2560)
+    parser.add_argument("--vllm_max_model_len", type=int, default=2048)
+    parser.add_argument("--store_cot_text", type=int, default=0)
+    parser.add_argument("--store_prompt_text", type=int, default=0)
+    main(parser.parse_args())
diff --git a/utils/extract_train_metrics.py b/utils/extract_train_metrics.py
new file mode 100644
index 0000000..fb97480
--- /dev/null
+++ b/utils/extract_train_metrics.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python
+"""Extract per-step training metrics from a verl GRPO .out log.
+
+Pulls the step-summary lines (those carrying both training/global_step and
+response_length/mean) and writes a tidy per-step CSV. `response_length_mean`
+is the average generated rollout length during training, the quantity the
+paper's Figure 5 uses for "avg reasoning length" — more faithful than
+eval-time CoT length.
+
+A constant for the non-reasoning scaffolding is subtracted so the column
+approximates pure reasoning length: the 3 answer SID tokens (<a><b><c>) plus
+~2 for </think> and a separator. This is a uniform shift — it does not change
+the trend or shape, only the offset.
+
+Usage:
+  python scripts/extract_train_metrics.py \
+      --log slurm_output/sid-S3-0p6B-games-rl-23771343.out \
+      --out results/train_lengths_0p6B.csv
+"""
+import re
+import csv
+import argparse
+
+# Generated response = reasoning + </think> + separator + 3 answer SID tokens.
+# Subtract that scaffolding (~5) to approximate reasoning length.
+SCAFFOLD_TOKENS = 5
+
+# logged key  ->  output column
+KEYS = {
+    "training/global_step": "step",
+    "response_length/mean": "response_length_mean",
+    "prompt_length/mean": "prompt_length_mean",
+    "actor/entropy": "entropy",
+    "critic/rewards/mean": "reward_mean",
+}
+PATS = {k: re.compile(re.escape(k) + r":([-\d.eE+]+)") for k in KEYS}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--log", required=True)
+    ap.add_argument("--out", default="results/train_lengths.csv")
+    args = ap.parse_args()
+
+    by_step = {}  # step -> row (last occurrence wins)
+    with open(args.log, errors="ignore") as f:
+        for line in f:
+            if "training/global_step" not in line or "response_length/mean" not in line:
+                continue
+            vals = {}
+            for key, pat in PATS.items():
+                m = pat.search(line)
+                if m:
+                    vals[KEYS[key]] = m.group(1)
+            if "step" not in vals or "response_length_mean" not in vals:
+                continue
+            step = int(float(vals["step"]))
+            vals["step"] = step
+            vals["response_length_mean"] = float(vals["response_length_mean"]) - SCAFFOLD_TOKENS
+            by_step[step] = vals
+
+    rows = [by_step[s] for s in sorted(by_step)]
+    if not rows:
+        print(f"No step-summary lines found in {args.log}")
+        return
+
+    fields = ["step", "response_length_mean", "prompt_length_mean", "entropy", "reward_mean"]
+    with open(args.out, "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=fields)
+        w.writeheader()
+        for r in rows:
+            w.writerow({k: r.get(k, "") for k in fields})
+
+    print(f"Wrote {args.out}  ({len(rows)} steps: {rows[0]['step']}..{rows[-1]['step']}, "
+          f"minus {SCAFFOLD_TOKENS} scaffold tokens)")
+    print(f"  reasoning length: {float(rows[0]['response_length_mean']):.1f} "
+          f"-> {float(rows[-1]['response_length_mean']):.1f}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/make_rq5_diversity_tables.py b/utils/make_rq5_diversity_tables.py
new file mode 100644
index 0000000..2263e1f
--- /dev/null
+++ b/utils/make_rq5_diversity_tables.py
@@ -0,0 +1,221 @@
+import argparse
+import json
+import math
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+
+
+SASREC = {
+    "Video_Games": {
+        "HR@10": (0.092424, 0.004296),
+        "NDCG@10": (0.051880, 0.003922),
+        "Coverage@10": (0.760325, 0.123184),
+        "Entropy@10": (6.504607, 0.499360),
+        "Gini@10": (0.830024, 0.074283),
+    },
+    "Office_Products": {
+        "HR@10": (0.135156, 0.001321),
+        "NDCG@10": (0.076461, 0.000921),
+        "Coverage@10": (0.874530, 0.035084),
+        "Entropy@10": (6.888911, 0.279589),
+        "Gini@10": (0.740512, 0.051658),
+    },
+}
+
+def _normalize(value):
+    return value.strip('"\n').strip()
+
+
+def _load_catalog(info_file):
+    with open(info_file, "r") as f:
+        items = [line.split("\t")[0].strip() for line in f]
+    return items, set(items)
+
+
+def _entropy(counts):
+    total = sum(counts.values())
+    if total == 0:
+        return 0.0
+    probs = np.array([count / total for count in counts.values()], dtype=np.float64)
+    return float(-(probs * np.log(probs + 1e-12)).sum())
+
+
+def _gini(counts, catalog_size):
+    """Exposure Gini over the full catalog, including unexposed items.
+
+    Zero exposures precede the sorted observed counts. Offset their ranks
+    rather than allocating a dense catalog-sized array. An all-zero exposure
+    vector returns 0.0, matching the SASRec evaluator's convention.
+    """
+    if catalog_size < len(counts) or catalog_size < 0:
+        raise ValueError("Catalog size cannot be smaller than the exposure counter")
+    if not counts:
+        return 0.0
+    values = np.array(sorted(counts.values()), dtype=np.float64)
+    if not np.all(np.isfinite(values)) or np.any(values < 0):
+        raise ValueError("Exposure counts must be finite and nonnegative")
+    total = values.sum()
+    if total == 0:
+        return 0.0
+    n = catalog_size
+    index = np.arange(n - len(values) + 1, n + 1)
+    return float((2 * np.sum(index * values) / (n * total)) - ((n + 1) / n))
+
+
+def _json_metrics(path, valid_items, catalog_size):
+    data = json.loads(Path(path).read_text())
+    hits = 0
+    ndcg = 0.0
+    recommended = []
+    for sample in data:
+        preds = [_normalize(pred) for pred in sample["predict"]]
+        target = sample["output"][0] if isinstance(sample["output"], list) else sample["output"]
+        target = target.strip(' \n"')
+        rank = next((idx for idx, pred in enumerate(preds) if pred == target), None)
+        if rank is not None and rank < 10:
+            hits += 1
+            ndcg += (1 / math.log(rank + 2)) / (1 / math.log(2))
+        recommended.extend(pred for pred in preds[:10] if pred in valid_items)
+    counts = Counter(recommended)
+    n = len(data)
+    return {
+        "HR@10": hits / n,
+        "NDCG@10": ndcg / n,
+        "Coverage@10": len(counts) / catalog_size,
+        "Entropy@10": _entropy(counts),
+        "Gini@10": _gini(counts, catalog_size),
+    }
+
+
+def _mean_std(values):
+    arr = np.array(values, dtype=np.float64)
+    return float(arr.mean()), float(arr.std(ddof=0))
+
+
+def _fmt(pair):
+    return f"{pair[0]:.6f} +/- {pair[1]:.6f}"
+
+
+def _delta(left, right, metric):
+    return left[metric][0] - right[metric][0]
+
+
+def build_table(dataset, result_root, output_path):
+    info_file = Path("data/Amazon/info") / f"{dataset}_5_2016-10-2018-11.txt"
+    catalog, valid_items = _load_catalog(info_file)
+    catalog_size = len(catalog)
+    result_root = Path(result_root)
+
+    rows = [("SASRec", "baseline", 3, SASREC[dataset])]
+    by_key = {("SASRec", "baseline"): SASREC[dataset]}
+    for stage, label in (("sft", "SFT"), ("ra", "SFT + RA"), ("rl", "SFT + RA + RL")):
+        for decoder in ("beam10", "sample_t12_p095", "sample_t10_k50"):
+            values = defaultdict(list)
+            for seed in (42, 43, 44):
+                path = (
+                    result_root
+                    / dataset
+                    / stage
+                    / f"{decoder}_seed{seed}"
+                    / f"final_result_thinking_{dataset}.json"
+                )
+                metrics = _json_metrics(path, valid_items, catalog_size)
+                for metric, value in metrics.items():
+                    values[metric].append(value)
+            aggregate = {metric: _mean_std(vals) for metric, vals in values.items()}
+            rows.append((label, decoder, 3, aggregate))
+            by_key[(label, decoder)] = aggregate
+
+    pretty_dataset = dataset.replace("_", " ")
+    lines = [
+        f"# {pretty_dataset} Item-side Diversity Comparison",
+        "",
+        "All values are at `K=10` and reported as `mean +/- std` across seeds `42,43,44`.",
+        "All SIDReasoner stages are recomputed from per-seed prediction JSONs. SASRec uses stored full-catalog baseline aggregates; verify the same catalog and test population before comparison.",
+        "Gini includes zero exposure for every unexposed catalog item.",
+        "",
+        "| Model | Decoding | Runs | HR@10 | NDCG@10 | Coverage@10 | Entropy@10 | Gini@10 |",
+        "|---|---|---:|---:|---:|---:|---:|---:|",
+    ]
+    for model, decoder, runs, metrics in rows:
+        decoder_label = f"`{decoder}`" if decoder != "baseline" else "baseline"
+        lines.append(
+            "| "
+            + " | ".join(
+                [
+                    model,
+                    decoder_label,
+                    str(runs),
+                    _fmt(metrics["HR@10"]),
+                    _fmt(metrics["NDCG@10"]),
+                    _fmt(metrics["Coverage@10"]),
+                    _fmt(metrics["Entropy@10"]),
+                    _fmt(metrics["Gini@10"]),
+                ]
+            )
+            + " |"
+        )
+    lines.extend(["", "## Quick Read", ""])
+    for decoder in ("beam10", "sample_t12_p095", "sample_t10_k50"):
+        subset = [row for row in rows if row[1] == decoder]
+        best_hr = max(subset, key=lambda row: row[3]["HR@10"][0])
+        best_cov = max(subset, key=lambda row: row[3]["Coverage@10"][0])
+        best_gini = min(subset, key=lambda row: row[3]["Gini@10"][0])
+        lines.append(
+            f"- `{decoder}`: best HR@10 is {best_hr[0]} ({best_hr[3]['HR@10'][0]:.6f}); "
+            f"best Coverage@10 is {best_cov[0]} ({best_cov[3]['Coverage@10'][0]:.6f}); "
+            f"lowest Gini@10 is {best_gini[0]} ({best_gini[3]['Gini@10'][0]:.6f})."
+        )
+
+    beam_sft = by_key[("SFT", "beam10")]
+    beam_ra = by_key[("SFT + RA", "beam10")]
+    beam_rl = by_key[("SFT + RA + RL", "beam10")]
+    sasrec = by_key[("SASRec", "baseline")]
+    lines.extend(
+        [
+            "",
+            "## Beam-stage Deltas",
+            "",
+            "| Beam setting comparison | Delta HR@10 | Delta NDCG@10 | Delta Coverage@10 | Delta Entropy@10 | Delta Gini@10 |",
+            "|---|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for label, left, right in (
+        ("`SFT + RA` minus `SFT`", beam_ra, beam_sft),
+        ("`SFT + RA + RL` minus `SFT + RA`", beam_rl, beam_ra),
+        ("`SFT + RA + RL` minus `SFT`", beam_rl, beam_sft),
+        ("`SFT + RA + RL` minus `SASRec`", beam_rl, sasrec),
+    ):
+        lines.append(
+            f"| {label} | {_delta(left, right, 'HR@10'):+.6f} | "
+            f"{_delta(left, right, 'NDCG@10'):+.6f} | "
+            f"{_delta(left, right, 'Coverage@10'):+.6f} | "
+            f"{_delta(left, right, 'Entropy@10'):+.6f} | "
+            f"{_delta(left, right, 'Gini@10'):+.6f} |"
+        )
+
+    Path(output_path).parent.mkdir(parents=True, exist_ok=True)
+    Path(output_path).write_text("\n".join(lines) + "\n")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--result-root", default="results/item_side_diversity")
+    parser.add_argument("--output-dir", default="results/item_side_diversity")
+    args = parser.parse_args()
+    build_table(
+        "Video_Games",
+        args.result_root,
+        Path(args.output_dir) / "video_games_sft_ra_rl_sasrec_comparison.md",
+    )
+    build_table(
+        "Office_Products",
+        args.result_root,
+        Path(args.output_dir) / "office_products_sft_ra_rl_sasrec_comparison.md",
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/utils/plot_figure5.py b/utils/plot_figure5.py
new file mode 100644
index 0000000..626cd37
--- /dev/null
+++ b/utils/plot_figure5.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python
+"""Figure-5-style plot: recommendation performance + CoT length vs RL steps.
+
+Single dual-axis plot (matches the paper's Figure 5 style):
+  left  y-axis = performance metric (default HR@10)      solid, circles
+  right y-axis = avg reasoning length (tokens)           dashed, squares
+  color = model: blue = 0.6B, red = 1.7B reference.
+
+The 0.6B CoT curve can be taken from the dense per-step training log
+(--cot_csv, column from extract_train_metrics.py) and subsampled every
+--cot_every steps so it matches the paper's 1.7B point spacing. If --cot_csv
+is omitted, CoT for the 0.6B series falls back to the cot column in --csv.
+
+Usage:
+  python scripts/plot_figure5.py \
+      --csv results/figure5_0p6B.csv \
+      --ref_csv results/figure5_1p7B.csv \
+      --cot_csv results/train_lengths_0p6B.csv --cot_every 50 \
+      --metric HR@10 \
+      --out results/figure5_0p6B_vs_1p7B.png
+"""
+import csv
+import argparse
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+
+
+def load_xy(path, xcol, ycol):
+    """Return (xs, ys) sorted by x for rows where ycol parses as float."""
+    xs, ys = [], []
+    with open(path, newline="") as f:
+        for row in csv.DictReader(f):
+            try:
+                x = float(row[xcol])
+                y = float(row[ycol])
+            except (TypeError, ValueError, KeyError):
+                continue
+            xs.append(x)
+            ys.append(y)
+    order = sorted(range(len(xs)), key=lambda i: xs[i])
+    return [xs[i] for i in order], [ys[i] for i in order]
+
+
+def subsample(xs, ys, every):
+    """Keep the first point plus every `every`-th step (x % every == 0)."""
+    ox, oy = [], []
+    for i, (x, y) in enumerate(zip(xs, ys)):
+        if i == 0 or x % every == 0:
+            ox.append(x)
+            oy.append(y)
+    return ox, oy
+
+
+C_NEW, C_REF = "#1f77b4", "#d62728"   # blue = 0.6B, red = 1.7B (comparison mode)
+C_PERF, C_COT = "#1f77b4", "#ff7f0e"  # blue = metric, orange = CoT (single-model mode)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--csv", required=True, help="0.6B metrics CSV (perf)")
+    ap.add_argument("--ref_csv", default=None, help="1.7B reference CSV (perf + cot)")
+    ap.add_argument("--cot_csv", default=None,
+                    help="dense per-step training CSV for the 0.6B CoT curve")
+    ap.add_argument("--cot_col", default="response_length_mean",
+                    help="CoT column name inside --cot_csv")
+    ap.add_argument("--csv_cot_col", default="cot_tokens",
+                    help="fallback CoT column in --csv when --cot_csv is not given")
+    ap.add_argument("--ref_cot_col", default="cot_tokens",
+                    help="CoT column in --ref_csv")
+    ap.add_argument("--cot_every", type=int, default=50)
+    ap.add_argument("--metric", default="HR@10")
+    ap.add_argument("--label", default="0.6B")
+    ap.add_argument("--ref_label", default="1.7B")
+    ap.add_argument("--out", default="./results/figure5.png")
+    args = ap.parse_args()
+
+    # Single-model figure -> colour by metric (perf vs CoT). Comparison (--ref_csv)
+    # -> colour by model (blue/red), perf solid / CoT dashed.
+    single = args.ref_csv is None
+    perf_color = C_PERF if single else C_NEW
+    cot_color = C_COT if single else C_NEW
+
+    fig, ax1 = plt.subplots(figsize=(7, 4.5))
+    ax2 = ax1.twinx()
+
+    # ---- 0.6B ----
+    sp, perf = load_xy(args.csv, "step", args.metric)
+    ax1.plot(sp, perf, color=perf_color, marker="o", linewidth=2,
+             label=f"{args.label}  {args.metric}")
+    if args.cot_csv:
+        sc, cot = load_xy(args.cot_csv, "step", args.cot_col)
+        sc, cot = subsample(sc, cot, args.cot_every)
+    else:
+        sc, cot = load_xy(args.csv, "step", args.csv_cot_col)
+    ax2.plot(sc, cot, color=cot_color, marker="s", linestyle="--", linewidth=1.5,
+             alpha=0.85, label=f"{args.label}  CoT len")
+
+    # ---- 1.7B reference ----
+    if args.ref_csv:
+        spr, perfr = load_xy(args.ref_csv, "step", args.metric)
+        ax1.plot(spr, perfr, color=C_REF, marker="o", linewidth=2,
+                 label=f"{args.ref_label}  {args.metric}")
+        scr, cotr = load_xy(args.ref_csv, "step", args.ref_cot_col)
+        ax2.plot(scr, cotr, color=C_REF, marker="s", linestyle="--", linewidth=1.5,
+                 alpha=0.85, label=f"{args.ref_label}  CoT len")
+
+    ax1.set_xlabel("RL training step")
+    ax1.set_ylabel(args.metric, color=perf_color if single else "black")
+    ax2.set_ylabel("avg reasoning length (tokens)", color=cot_color if single else "black")
+    if single:
+        ax1.tick_params(axis="y", colors=perf_color)
+        ax2.tick_params(axis="y", colors=cot_color)
+    ax1.grid(True, alpha=0.3)
+
+    h1, l1 = ax1.get_legend_handles_labels()
+    h2, l2 = ax2.get_legend_handles_labels()
+    ax1.legend(h1 + h2, l1 + l2, loc="lower right", bbox_to_anchor=(1.0, 0.18),
+               fontsize=9, framealpha=0.9)
+
+    plt.title(f"GRPO: {args.metric} and CoT length vs RL step")
+    fig.tight_layout()
+    fig.savefig(args.out, dpi=200)
+    print(f"Saved {args.out}")
+
+
+if __name__ == "__main__":
+    main()
