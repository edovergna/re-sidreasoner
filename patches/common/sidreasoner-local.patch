+def _sid_distance(left, right):
+    left_parts = _sid_parts(left)
+    right_parts = _sid_parts(right)
+    depth = max(len(left_parts), len(right_parts), 1)
+    shared = 0
+    for left_part, right_part in zip(left_parts, right_parts):
