+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=rq2-nonrl-vs-rl
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+if [[ -x "${PWD}/.venv/bin/python" ]]; then
+    PYTHON_CMD="${PWD}/.venv/bin/python"
+    export PYTHON_CMD
+fi
+
+DATASETS="${DATASETS:-Video_Games Office_Products}"
+SCRATCH_OUTPUT_ROOT="${SCRATCH_OUTPUT_ROOT:-./output_dir/continuations}"
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+NUM_SAMPLES="${NUM_SAMPLES:--1}"
+BATCH_SIZE="${BATCH_SIZE:-2}"
+NUM_BEAMS="${NUM_BEAMS:-10}"
+NUM_RETURN_SEQUENCES="${NUM_RETURN_SEQUENCES:-10}"
+MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
+SEED="${SEED:-42}"
+RESULT_ROOT="${RESULT_ROOT:-./results/rq2_nonrl_vs_rl}"
+TMP_ROOT="${TMP_ROOT:-${TMPDIR:-/tmp}/${USER:-user}/SIDReasoner_tmp/rq2_nonrl_vs_rl/${SLURM_JOB_ID:-manual}}"
+SUMMARY_MANIFEST="${SUMMARY_MANIFEST:-${RESULT_ROOT}/manifest_${SLURM_JOB_ID:-manual}.tsv}"
+SUMMARY_OUTPUT="${SUMMARY_OUTPUT:-${RESULT_ROOT}/summary_${SLURM_JOB_ID:-manual}.md}"
+LOG_FILE="${LOG_FILE:-./logs/rq2_nonrl_vs_rl_${SLURM_JOB_ID:-manual}.log}"
+
+mkdir -p ./logs ./slurm_output "${RESULT_ROOT}" "${TMP_ROOT}"
+printf "" > "${SUMMARY_MANIFEST}"
+
+dataset_paths() {
+    local dataset="$1"
+    TEST_FILE="./data/Amazon/test/${dataset}_5_2016-10-2018-11.csv"
+    INFO_FILE="./data/Amazon/info/${dataset}_5_2016-10-2018-11.txt"
+    ITEM_FILE="./data/Amazon/index/${dataset}.item.json"
+    INDEX_FILE="./data/Amazon/index/${dataset}.index.json"
+    if [[ "${dataset}" == "Video_Games" ]]; then
+        RA_CHECKPOINT="./pretrained/Video_Games/sidreasoner_ra_games"
+        SFT_OUTPUT_DIR="${SCRATCH_OUTPUT_ROOT}/Video_Games_ra_extra_sft_3epochs_Qwen3-1.7B"
+        MORE_RA_OUTPUT_DIR="${SCRATCH_OUTPUT_ROOT}/Video_Games_ra_extra_sft_10epochs_Qwen3-1.7B"
+        MORE_RA_CHECKPOINT="${MORE_RA_OUTPUT_DIR}/checkpoint-480"
+        RL_CHECKPOINT="./pretrained/Video_Games/Qwen3-1.7B_base_e2e-RA-GeneralReason_stepRule-smalllR_Games/actor_merged"
+    else
+        RA_CHECKPOINT="./pretrained/Office_Products/sidreasoner_ra_office"
+        SFT_OUTPUT_DIR="${SCRATCH_OUTPUT_ROOT}/Office_Products_ra_extra_sft_3epochs_Qwen3-1.7B"
+        MORE_RA_OUTPUT_DIR="${SCRATCH_OUTPUT_ROOT}/Office_Products_ra_extra_sft_10epochs_Qwen3-1.7B"
+        MORE_RA_CHECKPOINT="${MORE_RA_OUTPUT_DIR}/final_checkpoint"
+        RL_CHECKPOINT="./pretrained/Office_Products/Qwen3-1.7B_base_e2e-General_stepRule-smalllR_Office_Products/actor_merged"
+    fi
+}
+
+slugify() {
+    tr '[:upper:]' '[:lower:]' <<< "$1" | sed -E 's/[^a-z0-9]+/_/g; s/^_//; s/_$//'
+}
+
+run_eval() {
+    local dataset="$1"
+    local label="$2"
+    local checkpoint="$3"
+    local idx="$4"
+    local slug
+    slug="$(slugify "${label}")"
+    local run_name="${dataset}_${slug}_beam${NUM_BEAMS}_seed${SEED}"
+    local temp_dir="${TMP_ROOT}/${run_name}"
+    local output_dir="${RESULT_ROOT}/${dataset}/${slug}/beam${NUM_BEAMS}_seed${SEED}"
+    local output_json="${output_dir}/final_result_thinking_${dataset}.json"
+
+    echo
+    echo "============================================================"
+    echo "Running ${dataset} / ${label}"
+    echo "Checkpoint: ${checkpoint}"
+    echo "============================================================"
+
+    mkdir -p "${temp_dir}" "${output_dir}"
+    ${PYTHON_CMD} ./split.py --input_path "${TEST_FILE}" --output_path "${temp_dir}" --cuda_list "${CUDA_LIST_CSV}" --num_samples "${NUM_SAMPLES}"
+
+    pids=()
+    for gpu in ${CUDA_LIST}; do
+        if [[ -f "${temp_dir}/${gpu}.csv" ]]; then
+            master_port=$((24000 + (${SLURM_JOB_ID:-0} % 10000) + idx * 10 + gpu))
+            MASTER_ADDR=127.0.0.1 MASTER_PORT=${master_port} CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                --base_model "${checkpoint}" \
+                --info_file "${INFO_FILE}" \
+                --category "${dataset}" \
+                --test_data_path "${temp_dir}/${gpu}.csv" \
+                --item_file "${ITEM_FILE}" \
+                --index_file "${INDEX_FILE}" \
+                --result_json_data "${temp_dir}/${gpu}.json" \
+                --batch_size "${BATCH_SIZE}" \
+                --num_beams "${NUM_BEAMS}" \
+                --num_return_sequences "${NUM_RETURN_SEQUENCES}" \
+                --max_new_tokens "${MAX_NEW_TOKENS}" \
+                --length_penalty 0.0 \
+                --decoding_method beam \
+                --temperature 0.0 \
+                --reasoning_temperature 0.0 \
+                --top_p 1.0 \
+                --top_k 0 \
+                --seed "${SEED}" &
+            pids+=("$!")
+        fi
+    done
+    failed=0
+    for pid in "${pids[@]}"; do
+        if ! wait "${pid}"; then
+            failed=1
+        fi
+    done
+    if (( failed )); then
+        echo "Error: shard failed for ${run_name}"
+        exit 1
+    fi
+    actual_cuda_list=""
+    for gpu in ${CUDA_LIST}; do
+        [[ -f "${temp_dir}/${gpu}.json" ]] && actual_cuda_list="${actual_cuda_list}${gpu},"
+    done
+    actual_cuda_list="${actual_cuda_list%,}"
+    ${PYTHON_CMD} ./merge.py --input_path "${temp_dir}" --output_path "${output_json}" --cuda_list "${actual_cuda_list}"
+    ${PYTHON_CMD} ./calc.py --path "${output_json}" --item_path "${INFO_FILE}"
+    printf "%s\t%s\t%s\t%s\t%s\n" "${label}" "${dataset}" "${output_json}" "${INFO_FILE}" "${checkpoint}" >> "${SUMMARY_MANIFEST}"
+}
+
+{
+idx=0
+for dataset in ${DATASETS}; do
+    dataset_paths "${dataset}"
+    checkpoints=(
+        "RA:${RA_CHECKPOINT}"
+        "RA + extra SFT (best validation):${SFT_OUTPUT_DIR}/final_checkpoint"
+        "RA + more RA:${MORE_RA_CHECKPOINT}"
+        "RA + RL:${RL_CHECKPOINT}"
+    )
+    for required in "${TEST_FILE}" "${INFO_FILE}" "${ITEM_FILE}" "${INDEX_FILE}"; do
+        [[ -f "${required}" ]] || { echo "Missing ${required}"; exit 1; }
+    done
+    for spec in "${checkpoints[@]}"; do
+        checkpoint="${spec#*:}"
+        [[ -f "${checkpoint}/config.json" ]] || { echo "Checkpoint not usable: ${checkpoint}"; exit 1; }
+        run_eval "${dataset}" "${spec%%:*}" "${checkpoint}" "${idx}"
+        idx=$((idx + 1))
+    done
+done
+
+${PYTHON_CMD} ./utils/summarize_labeled_eval_table.py \
+    --manifest_path "${SUMMARY_MANIFEST}" \
+    --output_path "${SUMMARY_OUTPUT}" \
+    --title "RQ2: RA continuations versus RL" \
+    --topk "1,3,5,10"
+echo "Summary saved to ${SUMMARY_OUTPUT}"
+} 2>&1 | tee "${LOG_FILE}"
