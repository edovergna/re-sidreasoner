+#SBATCH --gpus=4
+#SBATCH --job-name=sid-S3-4B-games-act-1ep
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=10:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+# No email notifications are enabled by default.
+# Email notifications may be configured with sbatch --mail-user.
+
+# S3 Phase B: reasoning activation (Video Games, Qwen3-4B) at 1 EPOCH.
+# Run alongside the 5-epoch version to pick the better activation before GRPO.
+# Distinct output dir (_1epoch). 4 GPUs (torchrun DDP/FSDP) for speed + to fit 4B.
+# WARNING: multi-GPU final-save can deadlock -> if it hangs at save, kill it and use
+# the last checkpoint-N (== final, load_best=False). (0.6B evidence favors 5-epoch.)
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+
+CATEGORY="${CATEGORY:-Video_Games}"
+TRAIN_FILE="${TRAIN_FILE:-./data/Amazon/train/Video_Games_5_2016-10-2018-11.csv}"
+EVAL_FILE="${EVAL_FILE:-./data/Amazon/valid/Video_Games_5_2016-10-2018-11.csv}"
+TEST_FILE="${TEST_FILE:-./data/Amazon/test/Video_Games_5_2016-10-2018-11.csv}"
+INFO_FILE="${INFO_FILE:-./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt}"
+BASE_MODEL="${BASE_MODEL:-./output_dir/Video_Games_stage1_sft_Qwen3-4B_S3/final_checkpoint}"
+OUTPUT_DIR="${OUTPUT_DIR:-./output_dir/Video_Games_stage2_reasoning_activation_1epoch_Qwen3-4B_S3}"
+RUN_NAME="${RUN_NAME:-Video_Games_stage2_reasoning_activation_1epoch_Qwen3-4B_S3}"
+LOG_FILE="${LOG_FILE:-./logs/${RUN_NAME}.txt}"
+CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3}"
+NPROC_PER_NODE="${NPROC_PER_NODE:-4}"
+MASTER_PORT="${MASTER_PORT:-29527}"
+
+mkdir -p ./logs ./output_dir
+
+{
+echo "${TRAIN_FILE} ${EVAL_FILE} ${INFO_FILE} ${TEST_FILE}"
+
+CUDA_VISIBLE_DEVICES="${CUDA_DEVICES}" ${TORCHRUN_CMD} --nproc_per_node "${NPROC_PER_NODE}" --master_port "${MASTER_PORT}" \
+    sft_reasoning_activation.py \
+    --base_model "${BASE_MODEL}" \
+    --batch_size 1024 \
+    --micro_batch_size 8 \
+    --num_epochs 1 \
+    --train_file "${TRAIN_FILE}" \
+    --eval_file "${EVAL_FILE}" \
+    --output_dir "${OUTPUT_DIR}" \
+    --wandb_project MiniOneRec \
+    --wandb_run_name "${RUN_NAME}" \
+    --category "${CATEGORY}" \
+    --train_from_scratch False \
+    --seed 42 \
+    --sid_index_path "./data/Amazon/index/${CATEGORY}.index.json" \
+    --item_meta_path "./data/Amazon/index/${CATEGORY}.item.json" \
+    --reasoning_train_file "./data/Amazon/index/${CATEGORY}.integrated_narrative.csv" \
+    --train_new_token_embeddings_only False \
+    "$@"
+} 2>&1 | tee "${LOG_FILE}"
