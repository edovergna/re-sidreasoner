+#!/bin/bash
+#SBATCH --partition=gpu_h100
+#SBATCH --gpus=2
+#SBATCH --job-name=vg-acc-search
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=16
+#SBATCH --time=24:00:00
+#SBATCH --output=slurm_output/%x-%j.out
+
+set -euo pipefail
+
+if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/pyproject.toml" ]]; then
+    SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
+else
+    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fi
+cd "$SCRIPT_DIR"
+
+source ./final_scripts/cluster_env.sh
+if [[ -x "${PWD}/.venv/bin/python" ]]; then
+    PYTHON_CMD="${PWD}/.venv/bin/python"
+    export PYTHON_CMD
+fi
+
+CATEGORY="Video_Games"
+RA_CHECKPOINT="${RA_CHECKPOINT:-./pretrained/Video_Games/sidreasoner_ra_games}"
+RL_CHECKPOINT="${RL_CHECKPOINT:-./pretrained/Video_Games/Qwen3-1.7B_base_e2e-RA-GeneralReason_stepRule-smalllR_Games/actor_merged}"
+CHECKPOINT_SPECS="${CHECKPOINT_SPECS:-ra_pre_rl:${RA_CHECKPOINT} rl_post_grpo:${RL_CHECKPOINT}}"
+TEST_FILE="${TEST_FILE:-./data/Amazon/test/Video_Games_5_2016-10-2018-11.csv}"
+INFO_FILE="${INFO_FILE:-./data/Amazon/info/Video_Games_5_2016-10-2018-11.txt}"
+ITEM_FILE="${ITEM_FILE:-./data/Amazon/index/Video_Games.item.json}"
+INDEX_FILE="${INDEX_FILE:-./data/Amazon/index/Video_Games.index.json}"
+CUDA_LIST="${CUDA_LIST:-0 1}"
+CUDA_LIST_CSV="${CUDA_LIST_CSV:-0,1}"
+NUM_SAMPLES="${NUM_SAMPLES:--1}"
+MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
+BATCH_SIZE="${BATCH_SIZE:-2}"
+REASONING_TEMPERATURE="${REASONING_TEMPERATURE:-0.0}"
+SEEDS="${1:-${SEEDS:-42}}"
+SEEDS="${SEEDS//,/ }"
+RESULT_ROOT="${RESULT_ROOT:-./results/video_games_accuracy_search}"
+TMP_ROOT="${TMP_ROOT:-${TMPDIR:-/tmp}/${USER:-user}/SIDReasoner_tmp/video_games_accuracy_search/${SLURM_JOB_ID:-manual}}"
+SUMMARY_MANIFEST="${SUMMARY_MANIFEST:-${RESULT_ROOT}/accuracy_search_manifest_${SLURM_JOB_ID:-manual}.tsv}"
+
+mkdir -p ./logs ./slurm_output "${RESULT_ROOT}" "${TMP_ROOT}"
+printf "" > "${SUMMARY_MANIFEST}"
+
+requested_gpu_count=$(wc -w <<< "${CUDA_LIST}")
+if [[ "${SLURM_GPUS_ON_NODE:-}" =~ ^[0-9]+$ ]] && (( SLURM_GPUS_ON_NODE < requested_gpu_count )); then
+    echo "Error: CUDA_LIST requests ${requested_gpu_count} GPUs (${CUDA_LIST}), but Slurm allocated ${SLURM_GPUS_ON_NODE}."
+    exit 1
+fi
+
+for required_file in "${TEST_FILE}" "${INFO_FILE}" "${ITEM_FILE}" "${INDEX_FILE}"; do
+    if [[ ! -f "${required_file}" ]]; then
+        echo "Error: required file not found: ${required_file}"
+        exit 1
+    fi
+done
+
+for spec in ${CHECKPOINT_SPECS}; do
+    checkpoint_path="${spec#*:}"
+    if [[ ! -d "${checkpoint_path}" || ! -f "${checkpoint_path}/config.json" ]]; then
+        echo "Error: checkpoint does not look usable: ${checkpoint_path}"
+        exit 1
+    fi
+done
+
+config_names=(
+    "beam10"
+    "beam20"
+    "beam50"
+    "beam_sample20_t03_p09"
+    "beam_sample20_t05_p09"
+    "sample50_t07_p09"
+)
+decoding_methods=(
+    "beam"
+    "beam"
+    "beam"
+    "beam_sample"
+    "beam_sample"
+    "sample"
+)
+num_beams_by_config=(
+    "10"
+    "20"
+    "50"
+    "20"
+    "20"
+    "1"
+)
+num_return_sequences_by_config=(
+    "10"
+    "20"
+    "50"
+    "20"
+    "20"
+    "50"
+)
+temperatures=(
+    "0.0"
+    "0.0"
+    "0.0"
+    "0.3"
+    "0.5"
+    "0.7"
+)
+top_ps=(
+    "1.0"
+    "1.0"
+    "1.0"
+    "0.9"
+    "0.9"
+    "0.9"
+)
+top_ks=(
+    "0"
+    "0"
+    "0"
+    "0"
+    "0"
+    "0"
+)
+
+base_master_port=$((21000 + (${SLURM_JOB_ID:-0} % 10000)))
+
+echo "Video Games accuracy-oriented inference search"
+echo "Checkpoints: ${CHECKPOINT_SPECS}"
+echo "Test file: ${TEST_FILE}"
+echo "Python: ${PYTHON_CMD}"
+echo "Seeds: ${SEEDS}"
+echo "Configs: ${config_names[*]}"
+echo "Batch size: ${BATCH_SIZE}"
+echo "Temp root: ${TMP_ROOT}"
+echo "Result root: ${RESULT_ROOT}"
+echo "Manifest: ${SUMMARY_MANIFEST}"
+echo "============================================================"
+
+for spec in ${CHECKPOINT_SPECS}; do
+    checkpoint_label="${spec%%:*}"
+    checkpoint_path="${spec#*:}"
+
+    for seed in ${SEEDS}; do
+        for idx in "${!config_names[@]}"; do
+            config_name="${config_names[$idx]}"
+            decoding_method="${decoding_methods[$idx]}"
+            num_beams="${num_beams_by_config[$idx]}"
+            num_return_sequences="${num_return_sequences_by_config[$idx]}"
+            temperature="${temperatures[$idx]}"
+            top_p="${top_ps[$idx]}"
+            top_k="${top_ks[$idx]}"
+
+            run_name="${checkpoint_label}_${config_name}_seed${seed}"
+            temp_dir="${TMP_ROOT}/${run_name}"
+            output_dir="${RESULT_ROOT}/${checkpoint_label}/${config_name}_seed${seed}"
+            output_json="${output_dir}/final_result_thinking_${CATEGORY}.json"
+
+            echo
+            echo "============================================================"
+            echo "Running ${run_name}"
+            echo "Checkpoint: ${checkpoint_path}"
+            echo "decoding_method=${decoding_method} num_beams=${num_beams} num_return_sequences=${num_return_sequences} temperature=${temperature} top_p=${top_p} top_k=${top_k} reasoning_temperature=${REASONING_TEMPERATURE}"
+            echo "============================================================"
+
+            mkdir -p "${temp_dir}" "${output_dir}"
+
+            ${PYTHON_CMD} ./split.py \
+                --input_path "${TEST_FILE}" \
+                --output_path "${temp_dir}" \
+                --cuda_list "${CUDA_LIST_CSV}" \
+                --num_samples "${NUM_SAMPLES}"
+
+            pids=()
+            for gpu in ${CUDA_LIST}; do
+                if [[ -f "${temp_dir}/${gpu}.csv" ]]; then
+                    master_port=$((base_master_port + idx * 10 + gpu))
+                    MASTER_ADDR=127.0.0.1 MASTER_PORT=${master_port} CUDA_VISIBLE_DEVICES=${gpu} ${PYTHON_CMD} -u ./evaluate_Qwen3_think.py \
+                        --base_model "${checkpoint_path}" \
+                        --info_file "${INFO_FILE}" \
+                        --category "${CATEGORY}" \
+                        --test_data_path "${temp_dir}/${gpu}.csv" \
+                        --item_file "${ITEM_FILE}" \
+                        --index_file "${INDEX_FILE}" \
+                        --result_json_data "${temp_dir}/${gpu}.json" \
+                        --batch_size "${BATCH_SIZE}" \
+                        --num_beams "${num_beams}" \
+                        --num_return_sequences "${num_return_sequences}" \
+                        --max_new_tokens "${MAX_NEW_TOKENS}" \
+                        --length_penalty 0.0 \
+                        --decoding_method "${decoding_method}" \
+                        --temperature "${temperature}" \
+                        --reasoning_temperature "${REASONING_TEMPERATURE}" \
+                        --top_p "${top_p}" \
+                        --top_k "${top_k}" \
+                        --seed "${seed}" &
+                    pids+=("$!")
+                else
+                    echo "Warning: split file missing for GPU ${gpu}: ${temp_dir}/${gpu}.csv"
+                fi
+            done
+
+            failed=0
+            for pid in "${pids[@]}"; do
+                if ! wait "${pid}"; then
+                    failed=1
+                fi
+            done
+            if (( failed )); then
+                echo "Error: at least one evaluation shard failed for ${run_name}."
+                exit 1
+            fi
+
+            actual_cuda_list=""
+            for gpu in ${CUDA_LIST}; do
+                if [[ -f "${temp_dir}/${gpu}.json" ]]; then
+                    actual_cuda_list="${actual_cuda_list}${gpu},"
+                fi
+            done
+            actual_cuda_list="${actual_cuda_list%,}"
+            if [[ -z "${actual_cuda_list}" ]]; then
+                echo "Error: no shard result files produced for ${run_name}"
+                exit 1
+            fi
+
+            ${PYTHON_CMD} ./merge.py \
+                --input_path "${temp_dir}" \
+                --output_path "${output_json}" \
+                --cuda_list "${actual_cuda_list}"
+
+            echo "Metrics for ${run_name}"
+            ${PYTHON_CMD} ./calc.py \
+                --path "${output_json}" \
+                --item_path "${INFO_FILE}"
+
+            printf "%s\t%s\t%s\t%s\t%s\t%s\n" "${checkpoint_label}" "${config_name}" "${seed}" "${CATEGORY}" "${output_json}" "${INFO_FILE}" >> "${SUMMARY_MANIFEST}"
+        done
+    done
+done
+
+echo
+echo "All Video Games accuracy-search runs completed."
+echo "Results saved under: ${RESULT_ROOT}"
+echo "Manifest saved to: ${SUMMARY_MANIFEST}"
